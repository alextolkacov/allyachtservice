{
  "name": "all-yacht-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "astro check",
    "check:legal": "node scripts/check-legal-foundation.mjs",
    "check:i18n": "node scripts/check-spanish-localisation.mjs",
    "typecheck": "astro check && tsc --project functions/tsconfig.json --noEmit",
    "functions:types": "wrangler types --path=./functions/types.d.ts",
    "preview:cloudflare": "npm run build && wrangler pages dev dist"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.1.3",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "eslint": "^10.8.0",
    "eslint-plugin-astro": "^1.7.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "wrangler": "^4.114.0"
  }
}
