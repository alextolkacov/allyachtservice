# Keep the pre-launch Cloudflare Pages build out of search results.
# Change this to true only when the custom production domain is ready to launch.
PUBLIC_SITE_INDEXABLE=false
#
# Cloudflare Turnstile's official always-pass test sitekey for local work.
# Set the real public sitekey in both Preview and Production before deployment.
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
#
# Keep private credentials unprefixed in .dev.vars and access them only from
# Pages Functions. Static builds embed any PUBLIC_ value used at build time.
