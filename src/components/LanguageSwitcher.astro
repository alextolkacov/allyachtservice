---
import { languages, type Locale } from '../data/languages';
import {
  getRequiredRoutePath,
  getRoutePath,
  type RouteId,
} from '../data/navigation';

interface Props {
  currentLocale: Locale;
  routeId?: RouteId;
  mode?: 'compact' | 'full';
}

const { currentLocale, routeId, mode = 'compact' } = Astro.props;
---

<nav
  class:list={['language-switcher', `language-switcher-${mode}`]}
  aria-label="Language"
>
  <ul role="list">
    {
      languages.map((language) => {
        const equivalentPath = routeId
          ? getRoutePath(routeId, language.code)
          : undefined;
        const isEquivalent = Boolean(equivalentPath);
        const href =
          equivalentPath ?? getRequiredRoutePath('home', language.code);
        const isCurrent = isEquivalent && language.code === currentLocale;
        const ariaLabel = isEquivalent
          ? isCurrent
            ? `${language.label}, current page`
            : `${language.label} version`
          : `${language.label} homepage`;

        return (
          <li>
            <a
              href={href}
              hreflang={language.hreflang}
              lang={language.htmlLang}
              aria-current={isCurrent ? 'page' : undefined}
              aria-label={ariaLabel}
            >
              {mode === 'compact'
                ? language.code.toUpperCase()
                : language.nativeLabel}
            </a>
          </li>
        );
      })
    }
  </ul>
</nav>
