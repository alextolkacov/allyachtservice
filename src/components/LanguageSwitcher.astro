---
import { languages, type Locale } from '../data/languages';
import { getRoutePath, type RouteId } from '../data/navigation';

interface Props {
  currentLocale: Locale;
  routeId: RouteId;
  mode?: 'compact' | 'full';
}

const { currentLocale, routeId, mode = 'compact' } = Astro.props;
---

<nav
  class:list={['language-switcher', `language-switcher-${mode}`]}
  aria-label="Language"
>
  <ul role="list">
    {
      languages.map((language) => (
        <li>
          <a
            href={getRoutePath(routeId, language.code)}
            hreflang={language.hreflang}
            lang={language.htmlLang}
            aria-current={language.code === currentLocale ? 'page' : undefined}
            aria-label={`${language.label}: ${language.nativeLabel}`}
          >
            {mode === 'compact'
              ? language.code.toUpperCase()
              : language.nativeLabel}
          </a>
        </li>
      ))
    }
  </ul>
</nav>
