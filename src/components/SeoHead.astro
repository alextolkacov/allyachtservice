---
import type { Locale } from '../data/languages';
import { getLanguage } from '../data/languages';
import type { RouteId } from '../data/navigation';
import { siteConfig } from '../data/site';
import { getRouteAlternates } from '../utils/hreflang';
import { createSeoMetadata, type StructuredData } from '../utils/seo';

interface Props {
  title: string;
  description: string;
  locale: Locale;
  pathname: string;
  routeId?: RouteId;
  includeAlternates?: boolean;
  noindex?: boolean;
  imagePath?: string;
  imageAlt?: string;
  structuredData?: StructuredData | readonly StructuredData[];
  openGraphType?: 'website' | 'article';
  articlePublishedTime?: string;
  articleModifiedTime?: string;
  articleSection?: string;
  articleAuthor?: string;
}

const {
  title,
  description,
  locale,
  pathname,
  routeId,
  includeAlternates = true,
  noindex = false,
  imagePath,
  imageAlt,
  structuredData,
  openGraphType = 'website',
  articlePublishedTime,
  articleModifiedTime,
  articleSection,
  articleAuthor,
} = Astro.props;

const metadata = createSeoMetadata({
  title,
  description,
  locale,
  pathname,
  noindex,
  ...(imagePath ? { imagePath } : {}),
});
const alternates =
  includeAlternates && routeId ? getRouteAlternates(routeId) : [];
const alternateOpenGraphLocales = alternates
  .filter(
    (alternate) =>
      alternate.locale !== 'x-default' && alternate.locale !== locale,
  )
  .map((alternate) => getLanguage(alternate.locale as Locale).openGraphLocale);
const schemas = structuredData
  ? Array.isArray(structuredData)
    ? structuredData
    : [structuredData]
  : [];
const serializedSchemas = schemas.map((schema) =>
  JSON.stringify(schema).replace(/</gu, '\\u003c'),
);
---

<meta name="description" content={metadata.description} />
<meta name="robots" content={metadata.robots} />

<link rel="canonical" href={metadata.canonicalUrl} />
{
  alternates.map((alternate) => (
    <link rel="alternate" hreflang={alternate.hreflang} href={alternate.href} />
  ))
}
<link rel="sitemap" href="/sitemap-index.xml" />

<meta property="og:type" content={openGraphType} />
<meta property="og:site_name" content={siteConfig.name} />
<meta property="og:title" content={metadata.title} />
<meta property="og:description" content={metadata.description} />
<meta property="og:url" content={metadata.canonicalUrl} />
<meta property="og:locale" content={metadata.openGraphLocale} />
{
  alternateOpenGraphLocales.map((openGraphLocale) => (
    <meta property="og:locale:alternate" content={openGraphLocale} />
  ))
}
{
  metadata.imageUrl && (
    <>
      <meta property="og:image" content={metadata.imageUrl} />
      <meta property="og:image:alt" content={imageAlt ?? siteConfig.name} />
    </>
  )
}
{
  openGraphType === 'article' && (
    <>
      {articlePublishedTime && (
        <meta
          property="article:published_time"
          content={articlePublishedTime}
        />
      )}
      {articleModifiedTime && (
        <meta property="article:modified_time" content={articleModifiedTime} />
      )}
      {articleSection && (
        <meta property="article:section" content={articleSection} />
      )}
      {articleAuthor && (
        <meta property="article:author" content={articleAuthor} />
      )}
    </>
  )
}

<meta
  name="twitter:card"
  content={metadata.imageUrl ? 'summary_large_image' : 'summary'}
/>
<meta name="twitter:title" content={metadata.title} />
<meta name="twitter:description" content={metadata.description} />
{metadata.imageUrl && <meta name="twitter:image" content={metadata.imageUrl} />}
{
  metadata.imageUrl && (
    <meta name="twitter:image:alt" content={imageAlt ?? siteConfig.name} />
  )
}

{
  serializedSchemas.map((schema) => (
    <script is:inline type="application/ld+json" set:html={schema} />
  ))
}
