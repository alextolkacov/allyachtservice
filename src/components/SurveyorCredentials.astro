---
import type { Locale } from '../data/languages';
import {
  surveyorCredentialAssets,
  surveyorCredentialCopy,
} from '../data/surveyor-credentials';

interface Props {
  locale: Locale;
  variant?: 'full' | 'compact';
}

const { locale, variant = 'compact' } = Astro.props;
const copy = surveyorCredentialCopy[locale];
const assets = surveyorCredentialAssets;
const dialogId = `iims-certificate-${locale}`;
const dialogTitleId = `${dialogId}-title`;
---

{
  variant === 'full' ? (
    <section
      class="surveyor-credential surveyor-credential--full"
      id="professional-qualifications"
      aria-labelledby="professional-qualifications-heading"
      data-certificate-root
    >
      <h2 id="professional-qualifications-heading">{copy.sectionHeading}</h2>
      <div class="surveyor-credential-panel">
        <div class="surveyor-credential-identity">
          <img
            class="surveyor-credential-logo"
            src={assets.logo.src}
            alt={copy.logoAlt}
            width={assets.logo.width}
            height={assets.logo.height}
            loading="lazy"
            decoding="async"
          />
          <div>
            <p class="surveyor-credential-name">{copy.name}</p>
            <p class="surveyor-credential-title">{copy.title}</p>
            <p class="surveyor-credential-description">{copy.description}</p>
            <button
              class="button button-navy"
              type="button"
              aria-haspopup="dialog"
              aria-controls={dialogId}
              data-certificate-open
            >
              {copy.viewCertificate}
            </button>
          </div>
        </div>
        <button
          class="surveyor-certificate-preview"
          type="button"
          aria-label={copy.viewCertificate}
          aria-haspopup="dialog"
          aria-controls={dialogId}
          data-certificate-open
        >
          <img
            src={assets.certificate.previewSrc}
            alt={copy.certificateAlt}
            width={assets.certificate.previewWidth}
            height={assets.certificate.previewHeight}
            loading="lazy"
            decoding="async"
          />
        </button>
      </div>

      <dialog
        class="certificate-dialog"
        id={dialogId}
        aria-labelledby={dialogTitleId}
        data-certificate-dialog
      >
        <div class="certificate-dialog-header">
          <h3 id={dialogTitleId}>{copy.certificateDialogTitle}</h3>
          <button
            class="certificate-dialog-close"
            type="button"
            aria-label={copy.closeCertificate}
            data-certificate-close
          >
            <span aria-hidden="true">×</span>
          </button>
        </div>
        <div class="certificate-dialog-body">
          <img
            src={assets.certificate.previewSrc}
            alt={copy.certificateAlt}
            width={assets.certificate.previewWidth}
            height={assets.certificate.previewHeight}
          />
          <a
            class="button button-outline-navy"
            href={assets.certificate.src}
            target="_blank"
            rel="noopener noreferrer"
          >
            {copy.openOriginal}
            <span class="sr-only">, {copy.opensNewTab}</span>
          </a>
        </div>
      </dialog>
    </section>
  ) : (
    <section
      class="surveyor-credential surveyor-credential--compact"
      aria-labelledby={`surveyor-credential-${locale}`}
    >
      <h2 class="sr-only" id={`surveyor-credential-${locale}`}>
        {copy.compactHeading}
      </h2>
      <img
        class="surveyor-credential-logo"
        src={assets.logo.src}
        alt={copy.logoAlt}
        width={assets.logo.width}
        height={assets.logo.height}
        loading="lazy"
        decoding="async"
      />
      <div>
        <p class="surveyor-credential-title">{copy.title}</p>
        <p class="surveyor-credential-name">{copy.name}</p>
        <a class="text-arrow-link" href={copy.aboutHref}>
          {copy.viewCredentials} <span aria-hidden="true">→</span>
        </a>
      </div>
    </section>
  )
}

<script>
  document
    .querySelectorAll<HTMLElement>('[data-certificate-root]')
    .forEach((root) => {
      const dialog = root.querySelector<HTMLDialogElement>(
        '[data-certificate-dialog]',
      );
      const openButtons = root.querySelectorAll<HTMLButtonElement>(
        '[data-certificate-open]',
      );
      const closeButton = root.querySelector<HTMLButtonElement>(
        '[data-certificate-close]',
      );

      if (!dialog || !closeButton) return;

      openButtons.forEach((button) => {
        button.addEventListener('click', () => dialog.showModal());
      });
      closeButton.addEventListener('click', () => dialog.close());
      dialog.addEventListener('click', (event) => {
        if (event.target === dialog) dialog.close();
      });
    });
</script>
