---
import {
  getNavigationHref,
  getNavigationLinkLanguage,
  getRequiredRoutePath,
  primaryNavigation,
  type RouteId,
} from '../data/navigation';
import type { Locale } from '../data/languages';
import { siteConfig } from '../data/site';
import LanguageSwitcher from './LanguageSwitcher.astro';
import MobileNavigation from './MobileNavigation.astro';

interface Props {
  currentLocale: Locale;
  routeId?: RouteId;
}

const { currentLocale, routeId } = Astro.props;
const navigationProps = {
  currentLocale,
  ...(routeId ? { routeId } : {}),
};
---

<header class="site-header">
  <div class="header-inner site-container">
    <a
      class="brand-link"
      href={getRequiredRoutePath('home', currentLocale)}
      aria-label={`${siteConfig.name} home`}
    >
      <img
        class="brand-logo"
        src="/logo/all-yacht-service-logo.svg"
        width="180"
        height="120"
        alt=""
      />
      <span class="brand-name">All Yacht <span>Service</span></span>
    </a>

    <div class="desktop-header-controls">
      <nav aria-label="Primary navigation">
        <ul class="desktop-navigation" role="list">
          {
            primaryNavigation.map((item) => {
              const href = getNavigationHref(item, currentLocale);
              const linkLanguage = getNavigationLinkLanguage(
                item,
                currentLocale,
              );
              const isCurrent = 'routeId' in item && item.routeId === routeId;

              return (
                <li>
                  <a
                    class="desktop-navigation-link"
                    href={href}
                    lang={linkLanguage}
                    aria-current={isCurrent ? 'page' : undefined}
                  >
                    {item.labels[currentLocale]}
                  </a>
                </li>
              );
            })
          }
        </ul>
      </nav>
      <LanguageSwitcher {...navigationProps} mode="compact" />
    </div>

    <MobileNavigation {...navigationProps} />
  </div>
</header>
