---
import {
  desktopStandaloneNavigation,
  getNavigationHref,
  getNavigationLinkLanguage,
  getRequiredRoutePath,
  isServiceRoute,
  serviceNavigation,
  type RouteId,
} from '../data/navigation';
import type { Locale } from '../data/languages';
import { siteConfig } from '../data/site';
import LanguageSwitcher from './LanguageSwitcher.astro';
import MobileNavigation from './MobileNavigation.astro';
import { getSharedUi, isEnglishFallback } from '../i18n/ui';

interface Props {
  currentLocale: Locale;
  routeId?: RouteId;
}

const { currentLocale, routeId } = Astro.props;
const ui = getSharedUi(currentLocale);
const navigationProps = {
  currentLocale,
  ...(routeId ? { routeId } : {}),
};
const homeNavigationItem = desktopStandaloneNavigation.find(
  (item) => item.id === 'home',
);
const secondaryNavigationItems = desktopStandaloneNavigation.filter(
  (item) => item.id !== 'home',
);
const servicesAreCurrent = isServiceRoute(routeId);
---

<header class="site-header">
  <div class="header-inner site-container">
    <a
      class="brand-link"
      href={getRequiredRoutePath('home', currentLocale)}
      aria-label={`${siteConfig.name} ${ui.homepage}`}
    >
      <img
        class="brand-logo"
        src="/logo/all-yacht-service-logo.svg"
        width="180"
        height="120"
        alt=""
      />
      <span class="brand-name">All Yacht <span>Service</span></span>
    </a>

    <div class="desktop-header-controls">
      <nav aria-label={ui.primaryNavigation}>
        <ul class="desktop-navigation" role="list">
          {
            homeNavigationItem &&
              (() => {
                const item = homeNavigationItem;
                const href = getNavigationHref(item, currentLocale);
                const linkLanguage = getNavigationLinkLanguage(
                  item,
                  currentLocale,
                );
                const isCurrent = 'routeId' in item && item.routeId === routeId;
                const isFallback = isEnglishFallback(
                  currentLocale,
                  linkLanguage,
                );

                return (
                  <li>
                    <a
                      class="desktop-navigation-link"
                      href={href}
                      lang={isFallback ? undefined : linkLanguage}
                      aria-current={isCurrent ? 'page' : undefined}
                    >
                      {item.labels[currentLocale]}
                      {isFallback && (
                        <span class="navigation-language-note" lang="en">
                          {' '}
                          — {ui.englishFallback}
                        </span>
                      )}
                    </a>
                  </li>
                );
              })()
          }
          <li class="desktop-services-wrapper">
            <details class="desktop-services-item" data-services-menu>
              <summary
                class="desktop-navigation-link desktop-services-trigger"
                role="button"
                aria-controls="desktop-services-dropdown"
                aria-haspopup="true"
                aria-current={servicesAreCurrent ? 'page' : undefined}
                data-services-trigger
              >
                {ui.services}
              </summary>
              <ul
                class="desktop-services-dropdown"
                id="desktop-services-dropdown"
                role="list"
                data-services-dropdown
              >
                {
                  serviceNavigation.map((item) => {
                    const href = getNavigationHref(item, currentLocale);
                    const linkLanguage = getNavigationLinkLanguage(
                      item,
                      currentLocale,
                    );
                    const isCurrent =
                      'routeId' in item && item.routeId === routeId;
                    const isFallback = isEnglishFallback(
                      currentLocale,
                      linkLanguage,
                    );

                    return (
                      <li>
                        <a
                          href={href}
                          lang={isFallback ? undefined : linkLanguage}
                          aria-current={isCurrent ? 'page' : undefined}
                        >
                          {item.labels[currentLocale]}
                          {isFallback && (
                            <span class="navigation-language-note" lang="en">
                              {' '}
                              — {ui.englishFallback}
                            </span>
                          )}
                        </a>
                      </li>
                    );
                  })
                }
              </ul>
            </details>
          </li>
          {
            secondaryNavigationItems.map((item) => {
              const href = getNavigationHref(item, currentLocale);
              const linkLanguage = getNavigationLinkLanguage(
                item,
                currentLocale,
              );
              const isCurrent = 'routeId' in item && item.routeId === routeId;
              const isFallback = isEnglishFallback(currentLocale, linkLanguage);

              return (
                <li>
                  <a
                    class="desktop-navigation-link"
                    href={href}
                    lang={isFallback ? undefined : linkLanguage}
                    aria-current={isCurrent ? 'page' : undefined}
                  >
                    {item.labels[currentLocale]}
                    {isFallback && (
                      <span class="navigation-language-note" lang="en">
                        {' '}
                        — {ui.englishFallback}
                      </span>
                    )}
                  </a>
                </li>
              );
            })
          }
        </ul>
      </nav>
      <LanguageSwitcher {...navigationProps} mode="compact" />
    </div>

    <MobileNavigation {...navigationProps} />
  </div>
</header>

<script>
  const servicesMenus = document.querySelectorAll<HTMLDetailsElement>(
    'details[data-services-menu]',
  );

  servicesMenus.forEach((menu) => {
    const trigger = menu.querySelector<HTMLButtonElement>(
      '[data-services-trigger]',
    );
    const dropdown = menu.querySelector<HTMLElement>(
      '[data-services-dropdown]',
    );

    if (!trigger || !dropdown) return;

    const links = () =>
      Array.from(dropdown.querySelectorAll<HTMLAnchorElement>('a[href]'));

    const closeMenu = (restoreFocus = false) => {
      menu.open = false;
      trigger.setAttribute('aria-expanded', 'false');
      if (restoreFocus) trigger.focus();
    };

    const openMenu = (focusFirstLink = false) => {
      menu.open = true;
      trigger.setAttribute('aria-expanded', 'true');
      if (focusFirstLink) links()[0]?.focus();
    };

    menu.addEventListener('toggle', () => {
      trigger.setAttribute('aria-expanded', String(menu.open));
    });

    trigger.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowDown') {
        event.preventDefault();
        openMenu(true);
      } else if (event.key === 'Escape') {
        event.preventDefault();
        closeMenu(true);
      }
    });

    dropdown.addEventListener('keydown', (event) => {
      const menuLinks = links();
      const currentIndex = menuLinks.indexOf(
        document.activeElement as HTMLAnchorElement,
      );

      if (event.key === 'Escape') {
        event.preventDefault();
        closeMenu(true);
        return;
      }

      if (
        (event.key !== 'ArrowDown' && event.key !== 'ArrowUp') ||
        currentIndex < 0
      ) {
        return;
      }

      event.preventDefault();
      const direction = event.key === 'ArrowDown' ? 1 : -1;
      const nextIndex =
        (currentIndex + direction + menuLinks.length) % menuLinks.length;
      menuLinks[nextIndex]?.focus();
    });

    menu.addEventListener('focusout', () => {
      queueMicrotask(() => {
        if (!menu.contains(document.activeElement)) closeMenu();
      });
    });

    document.addEventListener('pointerdown', (event) => {
      if (menu.open && !menu.contains(event.target as Node)) {
        closeMenu();
      }
    });

    // Let the browser complete native anchor activation. Closing the parent
    // details element during the same click can hide the link before some
    // browsers perform their default navigation.
  });
</script>
