---
import {
  getRoutePath,
  primaryNavigation,
  type RouteId,
} from '../data/navigation';
import type { Locale } from '../data/languages';
import { siteConfig } from '../data/site';
import LanguageSwitcher from './LanguageSwitcher.astro';
import MobileNavigation from './MobileNavigation.astro';

interface Props {
  currentLocale: Locale;
  currentPath: string;
  routeId: RouteId;
}

const { currentLocale, currentPath, routeId } = Astro.props;
---

<header class="site-header">
  <div class="header-inner site-container">
    <a
      class="brand-link"
      href={getRoutePath('home', currentLocale)}
      aria-label={`${siteConfig.name} home`}
    >
      <img
        class="brand-logo"
        src="/logo/all-yacht-service-logo.svg"
        width="180"
        height="120"
        alt=""
      />
      <span class="brand-name">All Yacht <span>Service</span></span>
    </a>

    <div class="desktop-header-controls">
      <nav aria-label="Primary navigation">
        <ul class="desktop-navigation" role="list">
          {
            primaryNavigation.map((item) => {
              const href = getRoutePath(item.routeId, currentLocale);
              const isCurrent = href === currentPath;

              return (
                <li>
                  <a
                    class="desktop-navigation-link"
                    href={href}
                    aria-current={isCurrent ? 'page' : undefined}
                  >
                    {item.labels[currentLocale]}
                  </a>
                </li>
              );
            })
          }
        </ul>
      </nav>
      <LanguageSwitcher
        currentLocale={currentLocale}
        routeId={routeId}
        mode="compact"
      />
    </div>

    <MobileNavigation
      currentLocale={currentLocale}
      currentPath={currentPath}
      routeId={routeId}
    />
  </div>
</header>
