---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import {
  formatLegalReviewDate,
  getMissingProductionLegalFields,
  legalConfig,
} from '../data/legal';
import { getRequiredRoutePath, type RouteId } from '../data/navigation';
import {
  getPolicyLayoutCopy,
  type PolicyLocale,
  type PolicyTocItem,
} from '../i18n/policy';
import {
  businessEntityId,
  toAbsoluteUrl,
  type StructuredData,
} from '../utils/seo';

interface Props {
  title: string;
  description: string;
  heading: string;
  intro: string;
  pathname: string;
  routeId: RouteId;
  toc: readonly PolicyTocItem[];
  locale?: PolicyLocale;
}

const {
  title,
  description,
  heading,
  intro,
  pathname,
  routeId,
  toc,
  locale = 'en',
} = Astro.props;
const text = getPolicyLayoutCopy(locale);
const pageUrl = toAbsoluteUrl(pathname);
const webPageSchema: StructuredData = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': `${pageUrl}#page`,
  url: pageUrl,
  name: title,
  description,
  inLanguage: locale,
  about: {
    '@id': businessEntityId,
  },
};
const siteIsIndexable = import.meta.env.PUBLIC_SITE_INDEXABLE === 'true';
const missingLegalFields = getMissingProductionLegalFields();
const showDraftWarning = !siteIsIndexable && missingLegalFields.length > 0;
const relatedPolicies = text.relatedPolicies
  .filter((policy) => policy.routeId !== routeId)
  .map((policy) => ({
    href: getRequiredRoutePath(policy.routeId, locale),
    label: policy.label,
  }));
const homePath = getRequiredRoutePath('home', locale);
const contactPath = getRequiredRoutePath('contact', locale);
const breadcrumbLabel =
  locale === 'es'
    ? 'Migas de pan'
    : locale === 'ru'
      ? 'Навигационная цепочка'
      : 'Breadcrumbs';
---

<BaseLayout
  title={title}
  description={description}
  locale={locale}
  routeId={routeId}
  pathname={pathname}
  imagePath="/images/about-all-yacht-service.webp"
  imageAlt={text.imageAlt}
  structuredData={webPageSchema}
>
  <header id="policy-top" class="policy-hero">
    <div class="policy-shell site-container">
      <Breadcrumbs
        items={[
          { label: text.home, href: homePath },
          { label: heading, href: pathname },
        ]}
        ariaLabel={breadcrumbLabel}
        theme="dark"
      />
      <p class="eyebrow">{text.websiteInformation}</p>
      <h1>{heading}</h1>
      <p class="policy-intro">{intro}</p>
      <p class="policy-reviewed">
        {text.lastReviewed}: <time datetime={legalConfig.lastReviewed}
          >{formatLegalReviewDate(legalConfig.lastReviewed, locale)}</time
        >
      </p>
    </div>
  </header>

  <div class="policy-shell policy-page site-container">
    {
      showDraftWarning && (
        <aside
          class="policy-draft-notice"
          aria-labelledby="policy-draft-heading"
          role="status"
        >
          <h2 id="policy-draft-heading">{text.draftHeading}</h2>
          <p>{text.draftDescription}</p>
        </aside>
      )
    }

    <div class="policy-grid">
      <nav class="policy-toc" aria-labelledby="policy-toc-heading">
        <h2 id="policy-toc-heading">{text.contents}</h2>
        <ol>
          {
            toc.map((item) => (
              <li>
                <a href={`#${item.id}`}>{item.label}</a>
              </li>
            ))
          }
        </ol>
      </nav>

      <article class="policy-content">
        <slot />

        <section
          id="policy-contact"
          class="policy-contact"
          aria-labelledby="policy-contact-heading"
        >
          <h2 id="policy-contact-heading">{text.contactHeading}</h2>
          <p>
            {text.contactByEmail}
            {' '}<a href={`mailto:${legalConfig.email}`}>{legalConfig.email}</a>
            {' '}{text.orByPhone}
            {' '}<a href="tel:+34695718540">{legalConfig.phone}</a>.
          </p>
          <address>{legalConfig.publicOfficeAddress}</address>
        </section>
      </article>
    </div>

    <nav class="policy-related" aria-labelledby="related-policies-heading">
      <h2 id="related-policies-heading">{text.relatedHeading}</h2>
      <ul role="list">
        {
          relatedPolicies.map((policy) => (
            <li>
              <a href={policy.href}>
                {policy.label} <span aria-hidden="true">→</span>
              </a>
            </li>
          ))
        }
        <li>
          <a href={contactPath}
            >{text.contactLink} <span aria-hidden="true">→</span></a
          >
        </li>
      </ul>
    </nav>
    <a class="policy-return-top" href="#policy-top">
      {text.returnToTop}
      <span aria-hidden="true">↑</span>
    </a>
  </div>
</BaseLayout>
