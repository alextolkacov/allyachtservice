---
import { siteConfig } from '../data/site';
---

<footer class="mt-auto border-t border-graphite/15 bg-white">
  <div
    class="site-container grid gap-8 py-10 text-sm text-graphite md:grid-cols-2 lg:grid-cols-[1.2fr_1fr_1fr]"
  >
    <div>
      <p
        class="font-display text-base font-bold tracking-wide text-navy uppercase"
      >
        {siteConfig.name}
      </p>
      <p class="mt-3 max-w-md leading-6">{siteConfig.address.formatted}</p>
    </div>

    <div>
      <p class="font-semibold text-navy">Contact</p>
      <ul class="mt-3 space-y-2" role="list">
        <li>
          <a class="text-link" href={siteConfig.contact.phoneHref}>
            {siteConfig.contact.phone}
          </a>
        </li>
        <li>
          <a class="text-link" href={siteConfig.contact.emailHref}>
            {siteConfig.contact.email}
          </a>
        </li>
        <li>{siteConfig.workingHours.label}</li>
      </ul>
    </div>

    <div>
      <p class="font-semibold text-navy">Social</p>
      <ul class="mt-3 space-y-2" role="list">
        <li>
          <a class="text-link" href={siteConfig.social.instagram}>Instagram</a>
        </li>
        <li>
          <a class="text-link" href={siteConfig.social.linkedin}>LinkedIn</a>
        </li>
      </ul>
    </div>
  </div>

  <div class="border-t border-graphite/10">
    <p class="site-container py-5 text-xs text-graphite/80">
      &copy; {`${new Date().getFullYear()} ${siteConfig.name}`}
    </p>
  </div>
</footer>
