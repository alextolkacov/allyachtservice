---
import type { Locale } from '../data/languages';
import { languages } from '../data/languages';
import {
  getNavigationHref,
  getNavigationLinkLanguage,
  getRequiredRoutePath,
  primaryNavigation,
  type RouteId,
} from '../data/navigation';
import { siteConfig } from '../data/site';
import SocialLinks from './SocialLinks.astro';

interface Props {
  currentLocale: Locale;
  routeId?: RouteId;
}

const { currentLocale, routeId } = Astro.props;
const labels = {
  en: {
    description:
      'Yacht surveying and technical support throughout Spain and the Mediterranean.',
    navigation: 'Navigation',
    contact: 'Contact',
    languages: 'Languages',
    tools: 'Online Tools',
  },
  es: {
    description:
      'Inspección de yates y asistencia técnica en España y el Mediterráneo.',
    navigation: 'Navegación',
    contact: 'Contacto',
    languages: 'Idiomas',
    tools: 'Herramientas',
  },
  ru: {
    description:
      'Осмотр яхт и техническая поддержка в Испании и Средиземноморье.',
    navigation: 'Навигация',
    contact: 'Контакты',
    languages: 'Языки',
    tools: 'Инструменты',
  },
  fr: {
    description:
      'Expertise de yachts et assistance technique en Espagne et en Méditerranée.',
    navigation: 'Navigation',
    contact: 'Contact',
    languages: 'Langues',
    tools: 'Outils',
  },
  it: {
    description:
      'Perizie nautiche e assistenza tecnica in Spagna e nel Mediterraneo.',
    navigation: 'Navigazione',
    contact: 'Contatti',
    languages: 'Lingue',
    tools: 'Strumenti',
  },
  gr: {
    description:
      'Επιθεωρήσεις σκαφών και τεχνική υποστήριξη στην Ισπανία και τη Μεσόγειο.',
    navigation: 'Πλοήγηση',
    contact: 'Επικοινωνία',
    languages: 'Γλώσσες',
    tools: 'Εργαλεία',
  },
} as const;
const text = labels[currentLocale];
---

<footer class="site-footer">
  <div class="footer-main site-container">
    <div class="footer-brand">
      <a
        class="footer-brand-link"
        href={getRequiredRoutePath('home', currentLocale)}
        aria-label={`${siteConfig.name} home`}
      >
        <img
          src="/logo/all-yacht-service-logo.svg"
          width="180"
          height="120"
          alt=""
        />
        <span>{siteConfig.name}</span>
      </a>
      <p>{text.description}</p>
      <SocialLinks theme="light" showLabels={true} />
    </div>

    <div>
      <h2>{text.contact}</h2>
      <address>
        {siteConfig.address.lines.map((line) => <span>{line}</span>)}
      </address>
      <ul class="footer-link-list" role="list">
        <li>
          <a href={siteConfig.contact.phoneHref}>{siteConfig.contact.phone}</a>
        </li>
        <li>
          <a href={siteConfig.contact.emailHref}>{siteConfig.contact.email}</a>
        </li>
      </ul>
    </div>

    <div>
      <h2>{text.navigation}</h2>
      <ul class="footer-link-list footer-navigation" role="list">
        {
          primaryNavigation.map((item) => {
            const linkLanguage = getNavigationLinkLanguage(item, currentLocale);
            const isCurrent = 'routeId' in item && item.routeId === routeId;

            return (
              <li>
                <a
                  href={getNavigationHref(item, currentLocale)}
                  lang={linkLanguage}
                  aria-current={isCurrent ? 'page' : undefined}
                >
                  {item.labels[currentLocale]}
                </a>
              </li>
            );
          })
        }
      </ul>
    </div>

    <div>
      <h2>{text.tools}</h2>
      <ul class="footer-link-list" role="list">
        <li>
          <a href="/pre-purchase-survey-calculator" lang="en">
            Survey Cost Calculator
          </a>
        </li>
        <li>
          <a href="/yacht-delivery-calculator" lang="en">
            Yacht Delivery Cost Calculator
          </a>
        </li>
      </ul>
    </div>

    <div>
      <h2>{text.languages}</h2>
      <ul class="footer-link-list" role="list">
        {
          languages.map((language) => (
            <li>
              <a
                href={getRequiredRoutePath('home', language.code)}
                lang={language.htmlLang}
                hreflang={language.hreflang}
                aria-current={
                  language.code === currentLocale ? 'page' : undefined
                }
              >
                {language.nativeLabel}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div class="footer-legal">
    <div class="site-container footer-legal-inner">
      <p>&copy; {`${new Date().getFullYear()} ${siteConfig.name}`}</p>
    </div>
  </div>
</footer>
