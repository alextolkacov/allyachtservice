---
import type { Locale } from '../data/languages';
import { languages } from '../data/languages';
import {
  getNavigationHref,
  getNavigationLinkLanguage,
  getRequiredRoutePath,
  primaryNavigation,
  type RouteId,
} from '../data/navigation';
import { siteConfig } from '../data/site';
import { footerCopy, spanishFooter } from '../i18n/footer';
import { getSharedUi, isEnglishFallback } from '../i18n/ui';
import SocialLinks from './SocialLinks.astro';

interface Props {
  currentLocale: Locale;
  routeId?: RouteId;
}

const { currentLocale, routeId } = Astro.props;
const text = footerCopy[currentLocale];
const ui = getSharedUi(currentLocale);
const isSpanish = currentLocale === 'es';
---

<footer class="site-footer">
  <div class="footer-main site-container">
    <div class="footer-brand">
      <a
        class="footer-brand-link"
        href={getRequiredRoutePath('home', currentLocale)}
        aria-label={`${siteConfig.name} ${ui.homepage}`}
      >
        <img
          src="/logo/all-yacht-service-logo.svg"
          width="180"
          height="120"
          alt=""
        />
        <span>{siteConfig.name}</span>
      </a>
      <p>{text.description}</p>
      <SocialLinks theme="light" showLabels={true} locale={currentLocale} />
    </div>

    <div>
      <h2>{text.contact}</h2>
      <address>
        {
          (isSpanish ? spanishFooter.address : siteConfig.address.lines).map(
            (line) => <span>{line}</span>,
          )
        }
      </address>
      <ul class="footer-link-list" role="list">
        <li>
          <a href={siteConfig.contact.phoneHref}>
            {isSpanish && `${spanishFooter.phone}: `}
            {siteConfig.contact.phone}
          </a>
        </li>
        {
          isSpanish && (
            <li>
              <a
                href={siteConfig.contact.whatsappHref}
                target="_blank"
                rel="noopener noreferrer"
              >
                {spanishFooter.whatsapp}: {siteConfig.contact.whatsapp}
                <span class="sr-only">, {ui.opensNewTab}</span>
              </a>
            </li>
          )
        }
        <li>
          <a href={siteConfig.contact.emailHref}>
            {isSpanish && `${spanishFooter.email}: `}
            {siteConfig.contact.email}
          </a>
        </li>
      </ul>
      {
        isSpanish && (
          <div class="footer-office-details">
            <p>
              <strong>{spanishFooter.openingHours}:</strong>{' '}
              {spanishFooter.hours}
            </p>
            <p>{spanishFooter.appointments}</p>
          </div>
        )
      }
    </div>

    <div>
      <h2>{text.navigation}</h2>
      <ul class="footer-link-list footer-navigation" role="list">
        {
          primaryNavigation.map((item) => {
            const linkLanguage = getNavigationLinkLanguage(item, currentLocale);
            const isCurrent = 'routeId' in item && item.routeId === routeId;
            const isFallback = isEnglishFallback(currentLocale, linkLanguage);

            return (
              <li>
                <a
                  href={getNavigationHref(item, currentLocale)}
                  lang={isFallback ? undefined : linkLanguage}
                  aria-current={isCurrent ? 'page' : undefined}
                >
                  {item.labels[currentLocale]}
                  {isFallback && (
                    <span class="navigation-language-note">
                      {' '}
                      — {ui.englishFallbackLowercase}
                    </span>
                  )}
                </a>
              </li>
            );
          })
        }
        <li>
          <a
            href={getRequiredRoutePath('yachtSurveyTips', 'en')}
            lang={currentLocale === 'en' || currentLocale === 'es'
              ? undefined
              : 'en'}
            aria-current={routeId === 'yachtSurveyTips' ||
            routeId === 'deckMoistureSoftSpots' ||
            routeId === 'shinyHull'
              ? 'page'
              : undefined}
          >
            {
              isSpanish
                ? `${spanishFooter.yachtSurveyTips} — ${ui.englishFallbackLowercase}`
                : 'Yacht Survey Tips'
            }
          </a>
        </li>
      </ul>
    </div>

    <div>
      <h2>{text.tools}</h2>
      <ul class="footer-link-list" role="list">
        <li>
          <a
            href={getRequiredRoutePath(
              'prePurchaseSurveyCalculator',
              isSpanish ? 'es' : 'en',
            )}
            lang={isSpanish ? undefined : 'en'}
          >
            {isSpanish ? spanishFooter.tools.survey : 'Survey Cost Calculator'}
          </a>
        </li>
        <li>
          <a
            href={getRequiredRoutePath(
              'yachtDeliveryCalculator',
              isSpanish ? 'es' : 'en',
            )}
            lang={isSpanish ? undefined : 'en'}
          >
            {
              isSpanish
                ? spanishFooter.tools.delivery
                : 'Yacht Delivery Cost Calculator'
            }
          </a>
        </li>
      </ul>
    </div>

    <div>
      <h2>{text.legal}</h2>
      <ul class="footer-link-list" role="list">
        <li>
          <a
            href="/privacy-policy"
            lang={isSpanish ? undefined : 'en'}
            aria-current={routeId === 'privacyPolicy' ? 'page' : undefined}
          >
            {
              isSpanish
                ? `${spanishFooter.legal.privacy} — ${ui.englishFallbackLowercase}`
                : 'Privacy Policy'
            }
          </a>
        </li>
        <li>
          <a
            href="/cookie-policy"
            lang={isSpanish ? undefined : 'en'}
            aria-current={routeId === 'cookiePolicy' ? 'page' : undefined}
          >
            {
              isSpanish
                ? `${spanishFooter.legal.cookies} — ${ui.englishFallbackLowercase}`
                : 'Cookie Policy'
            }
          </a>
        </li>
        <li>
          <a
            href="/legal-notice"
            lang={isSpanish ? undefined : 'en'}
            aria-current={routeId === 'legalNotice' ? 'page' : undefined}
          >
            {
              isSpanish
                ? `${spanishFooter.legal.notice} — ${ui.englishFallbackLowercase}`
                : 'Legal Notice'
            }
          </a>
        </li>
        <li>
          <a
            href="/terms-and-conditions"
            lang={isSpanish ? undefined : 'en'}
            aria-current={routeId === 'termsAndConditions' ? 'page' : undefined}
          >
            {
              isSpanish
                ? `${spanishFooter.legal.terms} — ${ui.englishFallbackLowercase}`
                : 'Terms and Conditions'
            }
          </a>
        </li>
      </ul>
    </div>

    <div>
      <h2>{text.languages}</h2>
      <ul class="footer-link-list footer-language-list" role="list">
        {
          languages.map((language) => (
            <li>
              <a
                href={getRequiredRoutePath('home', language.code)}
                lang={language.htmlLang}
                hreflang={language.hreflang}
                aria-current={
                  language.code === currentLocale ? 'page' : undefined
                }
              >
                {language.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div class="footer-legal">
    <div class="site-container footer-legal-inner">
      <p>&copy; {`${new Date().getFullYear()} ${siteConfig.name}`}</p>
    </div>
  </div>
</footer>
