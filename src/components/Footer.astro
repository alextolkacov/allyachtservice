---
import type { Locale } from '../data/languages';
import { languages } from '../data/languages';
import { getRoutePath, primaryNavigation } from '../data/navigation';
import { siteConfig } from '../data/site';
import SocialLinks from './SocialLinks.astro';

interface Props {
  currentLocale: Locale;
}

const { currentLocale } = Astro.props;
const labels = {
  en: {
    description:
      'Yacht surveying and technical support throughout Spain and the Mediterranean.',
    navigation: 'Navigation',
    contact: 'Contact',
    languages: 'Languages',
    privacy: 'Privacy Policy',
    cookies: 'Cookie Policy',
    terms: 'Terms of Use',
  },
  es: {
    description:
      'Inspección de yates y asistencia técnica en España y el Mediterráneo.',
    navigation: 'Navegación',
    contact: 'Contacto',
    languages: 'Idiomas',
    privacy: 'Política de privacidad',
    cookies: 'Política de cookies',
    terms: 'Condiciones de uso',
  },
  ru: {
    description:
      'Осмотр яхт и техническая поддержка в Испании и Средиземноморье.',
    navigation: 'Навигация',
    contact: 'Контакты',
    languages: 'Языки',
    privacy: 'Политика конфиденциальности',
    cookies: 'Политика cookie',
    terms: 'Условия использования',
  },
  fr: {
    description:
      'Expertise de yachts et assistance technique en Espagne et en Méditerranée.',
    navigation: 'Navigation',
    contact: 'Contact',
    languages: 'Langues',
    privacy: 'Politique de confidentialité',
    cookies: 'Politique des cookies',
    terms: "Conditions d'utilisation",
  },
  it: {
    description:
      'Perizie nautiche e assistenza tecnica in Spagna e nel Mediterraneo.',
    navigation: 'Navigazione',
    contact: 'Contatti',
    languages: 'Lingue',
    privacy: 'Informativa sulla privacy',
    cookies: 'Informativa sui cookie',
    terms: 'Condizioni di utilizzo',
  },
  gr: {
    description:
      'Επιθεωρήσεις σκαφών και τεχνική υποστήριξη στην Ισπανία και τη Μεσόγειο.',
    navigation: 'Πλοήγηση',
    contact: 'Επικοινωνία',
    languages: 'Γλώσσες',
    privacy: 'Πολιτική απορρήτου',
    cookies: 'Πολιτική cookies',
    terms: 'Όροι χρήσης',
  },
} as const;
const text = labels[currentLocale];
const legalPath = (slug: string) =>
  currentLocale === 'en' ? `/${slug}` : `/${currentLocale}/${slug}`;
---

<footer class="site-footer">
  <div class="footer-main site-container">
    <div class="footer-brand">
      <a
        class="footer-brand-link"
        href={getRoutePath('home', currentLocale)}
        aria-label={`${siteConfig.name} home`}
      >
        <img
          src="/logo/all-yacht-service-logo.svg"
          width="180"
          height="120"
          alt=""
        />
        <span>{siteConfig.name}</span>
      </a>
      <p>{text.description}</p>
      <SocialLinks theme="light" showLabels={true} />
    </div>

    <div>
      <h2>{text.contact}</h2>
      <address>
        {siteConfig.address.lines.map((line) => <span>{line}</span>)}
      </address>
      <ul class="footer-link-list" role="list">
        <li>
          <a href={siteConfig.contact.phoneHref}>{siteConfig.contact.phone}</a>
        </li>
        <li>
          <a href={siteConfig.contact.emailHref}>{siteConfig.contact.email}</a>
        </li>
      </ul>
    </div>

    <div>
      <h2>{text.navigation}</h2>
      <ul class="footer-link-list footer-navigation" role="list">
        {
          primaryNavigation.map((item) => (
            <li>
              <a href={getRoutePath(item.routeId, currentLocale)}>
                {item.labels[currentLocale]}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <h2>{text.languages}</h2>
      <ul class="footer-link-list" role="list">
        {
          languages.map((language) => (
            <li>
              <a
                href={getRoutePath('home', language.code)}
                lang={language.htmlLang}
                hreflang={language.hreflang}
                aria-current={
                  language.code === currentLocale ? 'page' : undefined
                }
              >
                {language.nativeLabel}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div class="footer-legal">
    <div class="site-container footer-legal-inner">
      <p>&copy; {`${new Date().getFullYear()} ${siteConfig.name}`}</p>
      <ul role="list">
        <li><a href={legalPath('privacy-policy')}>{text.privacy}</a></li>
        <li><a href={legalPath('cookie-policy')}>{text.cookies}</a></li>
        <li><a href={legalPath('terms-of-use')}>{text.terms}</a></li>
      </ul>
    </div>
  </div>
</footer>
