---
import { siteConfig } from '../data/site';

interface Props {
  heading: string;
  body?: string;
  phoneLabel: string;
  emailLabel: string;
  whatsappLabel: string;
}

const { heading, body, phoneLabel, emailLabel, whatsappLabel } = Astro.props;
---

<aside
  class="rounded-sm bg-navy px-6 py-8 text-ivory sm:px-8"
  aria-labelledby="contact-cta-title"
>
  <h2 id="contact-cta-title" class="font-display text-2xl font-bold text-white">
    {heading}
  </h2>
  {body && <p class="mt-3 max-w-2xl leading-7 text-ivory/80">{body}</p>}
  <div class="mt-6 flex flex-wrap gap-3">
    <a class="button button-light" href={siteConfig.contact.phoneHref}>
      {phoneLabel}
    </a>
    <a class="button button-outline-light" href={siteConfig.contact.emailHref}>
      {emailLabel}
    </a>
    <a
      class="button button-outline-light"
      href={siteConfig.contact.whatsappHref}
    >
      {whatsappLabel}
    </a>
  </div>
</aside>
