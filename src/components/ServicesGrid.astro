---
import type { HomeService } from '../data/home';
import ServiceCard from './ServiceCard.astro';

interface Props {
  heading: string;
  services: readonly HomeService[];
  linkLabel?: string;
  eyebrow?: string;
}

const {
  heading,
  services,
  linkLabel = 'More info',
  eyebrow = 'Surveying & technical support',
} = Astro.props;
---

<section
  id="services"
  class="section services-section"
  aria-labelledby="services-heading"
>
  <div class="site-container">
    <div class="section-heading-wrap section-heading-centered">
      <p class="eyebrow">{eyebrow}</p>
      <h2 id="services-heading" class="section-heading">{heading}</h2>
    </div>
    <div class="services-grid">
      {
        services.map((service) => (
          <ServiceCard {...service} linkLabel={linkLabel} />
        ))
      }
    </div>
  </div>
</section>
