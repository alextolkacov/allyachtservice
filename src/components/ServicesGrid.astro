---
import type { HomeService } from '../data/home';
import ServiceCard from './ServiceCard.astro';

interface Props {
  heading: string;
  services: readonly HomeService[];
  linkLabel?: string;
  eyebrow?: string;
  sectionId?: string;
}

const {
  heading,
  services,
  linkLabel = 'More info',
  eyebrow = 'Surveying & technical support',
  sectionId = 'services',
} = Astro.props;
const headingId = `${sectionId}-heading`;
---

<section
  id={sectionId}
  class="section services-section"
  aria-labelledby={headingId}
>
  <div class="site-container">
    <div class="section-heading-wrap section-heading-centered">
      <p class="eyebrow">{eyebrow}</p>
      <h2 id={headingId} class="section-heading">{heading}</h2>
    </div>
    <div class="services-grid">
      {
        services.map((service) => (
          <ServiceCard {...service} linkLabel={linkLabel} />
        ))
      }
    </div>
  </div>
</section>
