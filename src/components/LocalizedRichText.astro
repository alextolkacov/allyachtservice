---
import type { LocalizedRichText } from '../data/es/types';

interface Props {
  content: LocalizedRichText;
}

const { content } = Astro.props;
const parts = typeof content === 'string' ? [content] : content;
---

{
  parts.map((part) =>
    typeof part === 'string' ? (
      part
    ) : (
      <a class="text-link" href={part.href} lang={part.lang}>
        {part.text}
        {part.languageNote && (
          <span class="navigation-language-note"> — {part.languageNote}</span>
        )}
      </a>
    ),
  )
}
