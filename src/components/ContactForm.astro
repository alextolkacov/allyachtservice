---
import { contactPage } from '../data/contact';
import type { Locale } from '../data/languages';
import {
  contactFormCopy,
  getContactLocale,
  getContactServiceOptions,
} from '../i18n/contact';

interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;
const contactLocale = getContactLocale(locale);
const copy = contactFormCopy[contactLocale];
const services = getContactServiceOptions(contactLocale);
const calculatorPathPrefix = contactLocale === 'es' ? '/es' : '';
const turnstileSiteKey =
  import.meta.env.PUBLIC_TURNSTILE_SITE_KEY?.trim() ?? '';
const turnstileIsConfigured = turnstileSiteKey.length > 0;
---

<div class="contact-form-shell">
  <div class="contact-form-heading">
    <p class="eyebrow">{copy.eyebrow}</p>
    <h2 id="contact-form-heading">{copy.heading}</h2>
    <p>
      {copy.requiredIntro}
      <span aria-hidden="true">*</span><span class="sr-only"
        >{copy.requiredMarker}</span
      >.
    </p>
  </div>

  <form
    class="contact-form"
    action="/api/contact"
    method="post"
    enctype="multipart/form-data"
    aria-labelledby="contact-form-heading"
    novalidate={contactLocale === 'es'}
    data-contact-form
    data-locale={contactLocale}
  >
    <input type="hidden" name="submissionId" value="" />
    <input type="hidden" name="formStartedAt" value="" />
    <input type="hidden" name="source" value="contact-page" />
    <input type="hidden" name="pageUrl" value="" />
    <input type="hidden" name="estimateReference" value="" />
    <input type="hidden" name="calculatorSummary" value="" />
    <input type="hidden" name="locale" value={contactLocale} />

    <section
      class="contact-survey-estimate"
      aria-labelledby="contact-survey-estimate-heading"
      hidden
      data-survey-estimate-summary
    >
      <p class="eyebrow">{copy.transferred}</p>
      <h3 id="contact-survey-estimate-heading">
        {copy.surveyEstimate.heading}
      </h3>
      <p>{copy.surveyEstimate.intro}</p>
      <dl>
        <div>
          <dt>{copy.surveyEstimate.reference}</dt>
          <dd data-contact-estimate-reference></dd>
        </div>
        <div>
          <dt>{copy.surveyEstimate.price}</dt>
          <dd data-contact-estimate-price></dd>
        </div>
        <div>
          <dt>{copy.surveyEstimate.created}</dt>
          <dd data-contact-estimate-date></dd>
        </div>
        <div>
          <dt>{copy.surveyEstimate.loa}</dt>
          <dd data-contact-estimate-loa></dd>
        </div>
        <div>
          <dt>{copy.surveyEstimate.vessel}</dt>
          <dd data-contact-estimate-vessel></dd>
        </div>
        <div>
          <dt>{copy.surveyEstimate.package}</dt>
          <dd data-contact-estimate-package></dd>
        </div>
        <div>
          <dt>{copy.surveyEstimate.hull}</dt>
          <dd data-contact-estimate-hull></dd>
        </div>
        <div hidden data-contact-estimate-location-row>
          <dt>{copy.surveyEstimate.location}</dt>
          <dd data-contact-estimate-location></dd>
        </div>
        <div hidden data-contact-estimate-discount-row>
          <dt>{copy.surveyEstimate.discount}</dt>
          <dd data-contact-estimate-discount></dd>
        </div>
      </dl>
      <h4>{copy.surveyEstimate.items}</h4>
      <ul class="service-check-list" data-contact-estimate-items></ul>
      <p class="contact-survey-estimate-note">
        {copy.surveyEstimate.note}
      </p>
      <button
        class="button button-outline-navy"
        type="button"
        data-remove-survey-estimate
      >
        {copy.surveyEstimate.remove}
      </button>
    </section>

    <section
      class="contact-survey-estimate contact-delivery-estimate"
      aria-labelledby="contact-delivery-estimate-heading"
      hidden
      data-delivery-estimate-summary
    >
      <p class="eyebrow">{copy.transferred}</p>
      <h3 id="contact-delivery-estimate-heading">
        {copy.deliveryEstimate.heading}
      </h3>
      <p>{copy.deliveryEstimate.intro}</p>
      <dl>
        <div>
          <dt>{copy.deliveryEstimate.reference}</dt>
          <dd data-contact-delivery-reference></dd>
        </div>
        <div>
          <dt>{copy.deliveryEstimate.created}</dt>
          <dd data-contact-delivery-date></dd>
        </div>
        <div>
          <dt>{copy.deliveryEstimate.departure}</dt>
          <dd data-contact-delivery-departure></dd>
        </div>
        <div>
          <dt>{copy.deliveryEstimate.destination}</dt>
          <dd data-contact-delivery-destination></dd>
        </div>
        <div>
          <dt>{copy.deliveryEstimate.distance}</dt>
          <dd data-contact-delivery-distance></dd>
        </div>
        <div>
          <dt>{copy.deliveryEstimate.fee}</dt>
          <dd data-contact-delivery-price></dd>
        </div>
        <div>
          <dt>{copy.deliveryEstimate.yachtType}</dt>
          <dd data-contact-delivery-yacht-type></dd>
        </div>
        <div>
          <dt>{copy.deliveryEstimate.lengthBand}</dt>
          <dd data-contact-delivery-length-band></dd>
        </div>
        <div>
          <dt>{copy.deliveryEstimate.complexity}</dt>
          <dd data-contact-delivery-complexity></dd>
        </div>
        <div>
          <dt>{copy.deliveryEstimate.timing}</dt>
          <dd data-contact-delivery-urgency></dd>
        </div>
        <div class="contact-delivery-corridor">
          <dt>{copy.deliveryEstimate.corridor}</dt>
          <dd data-contact-delivery-corridor></dd>
        </div>
      </dl>
      <p class="contact-survey-estimate-note">
        {copy.deliveryEstimate.note}
      </p>
      <button
        class="button button-outline-navy"
        type="button"
        data-remove-delivery-estimate
      >
        {copy.deliveryEstimate.remove}
      </button>
    </section>

    <div class="form-field form-field-honeypot" aria-hidden="true">
      <label for="contact-website">{copy.honeypot}</label>
      <input
        id="contact-website"
        name="website"
        type="text"
        tabindex="-1"
        autocomplete="off"
      />
    </div>

    <div class="contact-form-grid">
      <div class="form-field">
        <label for="contact-name"
          >{copy.fields.name} <span aria-hidden="true">*</span></label
        >
        <input
          id="contact-name"
          name="name"
          type="text"
          autocomplete="name"
          minlength="2"
          maxlength="100"
          required
          aria-describedby="contact-name-error"
        />
        <p
          id="contact-name-error"
          class="form-field-error"
          data-field-error="name"
          aria-live="polite"
        >
        </p>
      </div>

      <div class="form-field">
        <label for="contact-email"
          >{copy.fields.email} <span aria-hidden="true">*</span></label
        >
        <input
          id="contact-email"
          name="email"
          type="email"
          autocomplete="email"
          maxlength="254"
          required
          aria-describedby="contact-email-error"
        />
        <p
          id="contact-email-error"
          class="form-field-error"
          data-field-error="email"
          aria-live="polite"
        >
        </p>
      </div>

      <div class="form-field">
        <label for="contact-phone">{copy.fields.phone}</label>
        <input
          id="contact-phone"
          name="phone"
          type="tel"
          autocomplete="tel"
          maxlength="50"
          aria-describedby="contact-phone-error"
        />
        <p
          id="contact-phone-error"
          class="form-field-error"
          data-field-error="phone"
          aria-live="polite"
        >
        </p>
      </div>

      <div class="form-field">
        <label for="contact-service">{copy.fields.service}</label>
        <select
          id="contact-service"
          name="service"
          aria-describedby="contact-service-error contact-valuation-damage-help"
        >
          <option value="">{copy.selectService}</option>
          {
            services.map((service) => (
              <option value={service.value}>{service.label}</option>
            ))
          }
        </select>
        <p
          id="contact-service-error"
          class="form-field-error"
          data-field-error="service"
          aria-live="polite"
        >
        </p>
        <p
          class="contact-calculator-suggestion"
          hidden
          data-survey-calculator-suggestion
        >
          <a href={`${calculatorPathPrefix}/pre-purchase-survey-calculator`}>
            {copy.surveyCalculatorSuggestion}
          </a>
        </p>
        <p
          class="contact-calculator-suggestion"
          hidden
          data-delivery-calculator-suggestion
        >
          <a href={`${calculatorPathPrefix}/yacht-delivery-calculator`}>
            {copy.deliveryCalculatorSuggestion}
          </a>
        </p>
        <p
          id="contact-valuation-damage-help"
          class="form-field-help contact-service-helper"
          hidden
          data-valuation-damage-helper
        >
          {copy.valuationDamageHelper}
        </p>
      </div>

      <div class="form-field">
        <label for="contact-vessel-type">{copy.fields.vesselType}</label>
        <select
          id="contact-vessel-type"
          name="vesselType"
          aria-describedby="contact-vesselType-error"
        >
          <option value="">{copy.vesselTypes.select}</option>
          <option value="sailing-yacht">{copy.vesselTypes.sailing}</option>
          <option value="motor-yacht">{copy.vesselTypes.motor}</option>
          <option value="catamaran">{copy.vesselTypes.catamaran}</option>
          <option value="other">{copy.vesselTypes.other}</option>
        </select>
        <p
          id="contact-vesselType-error"
          class="form-field-error"
          data-field-error="vesselType"
          aria-live="polite"
        >
        </p>
      </div>

      <div class="form-field">
        <label for="contact-vessel-length">{copy.fields.vesselLength}</label>
        <div class="form-input-suffix">
          <input
            id="contact-vessel-length"
            name="vesselLength"
            type="number"
            inputmode="decimal"
            min="1"
            max="99"
            step="0.1"
            placeholder="12.5"
            aria-describedby="contact-vessel-length-help contact-vesselLength-error"
          />
          <span aria-hidden="true">m</span>
        </div>
        <p id="contact-vessel-length-help" class="form-field-help">
          {copy.vesselLengthHelp}
        </p>
        <p
          id="contact-vesselLength-error"
          class="form-field-error"
          data-field-error="vesselLength"
          aria-live="polite"
        >
        </p>
      </div>

      <div class="form-field">
        <label for="contact-vessel-location">{copy.fields.vesselLocation}</label
        >
        <input
          id="contact-vessel-location"
          name="vesselLocation"
          type="text"
          autocomplete="off"
          maxlength="120"
          placeholder={copy.vesselLocationPlaceholder}
          aria-describedby="contact-vesselLocation-error"
        />
        <p
          id="contact-vesselLocation-error"
          class="form-field-error"
          data-field-error="vesselLocation"
          aria-live="polite"
        >
        </p>
      </div>

      <div class="form-field">
        <label for="contact-preferred-date">{copy.fields.preferredDate}</label>
        <input
          id="contact-preferred-date"
          name="preferredDate"
          type="date"
          aria-describedby="contact-preferredDate-error"
        />
        <p
          id="contact-preferredDate-error"
          class="form-field-error"
          data-field-error="preferredDate"
          aria-live="polite"
        >
        </p>
      </div>
    </div>

    <div class="form-field">
      <label for="contact-message"
        >{copy.fields.message} <span aria-hidden="true">*</span></label
      >
      <textarea
        id="contact-message"
        name="message"
        rows="7"
        minlength="20"
        maxlength="5000"
        required
        aria-describedby="contact-message-help contact-message-error"
      ></textarea>
      <div class="form-field-meta">
        <p id="contact-message-help" class="form-field-help">
          {copy.messageHelp}
        </p>
        <p class="form-character-count" data-message-count>0 / 5,000</p>
      </div>
      <p
        id="contact-message-error"
        class="form-field-error"
        data-field-error="message"
        aria-live="polite"
      >
      </p>
    </div>

    <div class="form-field">
      <label for="contact-attachments">{copy.fields.attachments}</label>
      <input
        id="contact-attachments"
        name="attachments"
        type="file"
        accept=".pdf,.jpg,.jpeg,.png,.webp,application/pdf,image/jpeg,image/png,image/webp"
        multiple
        aria-describedby="contact-attachments-help contact-attachments-error"
      />
      <p id="contact-attachments-help" class="form-field-help">
        {copy.attachmentsHelp}
      </p>
      <p
        id="contact-attachments-error"
        class="form-field-error"
        data-field-error="attachments"
        aria-live="polite"
      >
      </p>
    </div>

    <div class="form-consent">
      <input
        id="contact-consent"
        name="consent"
        type="checkbox"
        value="yes"
        required
        aria-describedby="contact-consent-error"
      />
      <label for="contact-consent">
        {copy.acknowledgementBefore}
        {' '}<a href="/privacy-policy">{copy.privacyPolicy}</a>{' '}
        {copy.acknowledgementAfter}
        <span aria-hidden="true">*</span>
        {
          copy.privacyLanguageNote && (
            <span class="privacy-language-note">
              {' '}
              {copy.privacyLanguageNote}
            </span>
          )
        }
      </label>
    </div>
    <p
      id="contact-consent-error"
      class="form-field-error"
      data-field-error="consent"
      aria-live="polite"
    >
    </p>

    {
      turnstileIsConfigured ? (
        <div
          class="form-verification"
          data-turnstile-container
          tabindex="-1"
          aria-describedby="contact-verification-error"
        >
          <div
            class="cf-turnstile"
            data-sitekey={turnstileSiteKey}
            data-action="contact"
            data-theme="light"
          />
        </div>
      ) : (
        <p class="form-configuration-notice" role="status">
          {copy.configurationNotice}
        </p>
      )
    }
    <p
      id="contact-verification-error"
      class="form-field-error"
      data-field-error="verification"
      aria-live="polite"
    >
    </p>

    <div
      class="form-status"
      data-form-status
      role="status"
      aria-live="polite"
      tabindex="-1"
    >
    </div>

    <div class="contact-form-actions">
      <button
        class="button button-navy"
        type="submit"
        disabled={!turnstileIsConfigured}
        data-submit-button
      >
        <span data-submit-label>{copy.submit}</span>
      </button>
      <p>{copy.responseNote}</p>
    </div>

    <noscript>
      <p class="form-configuration-notice">
        {copy.noscriptBefore}{' '}
        <a href={contactPage.directContact.emailHref}
          >{contactPage.directContact.email}</a
        >{' '}
        {copy.noscriptAfter}
      </p>
    </noscript>
  </form>
</div>

{
  turnstileIsConfigured && (
    <script
      is:inline
      src="https://challenges.cloudflare.com/turnstile/v0/api.js"
      async
      defer
    />
  )
}

<script>
  import { surveyLabels } from '../lib/calculators/prePurchaseSurvey';
  import {
    createSurveyEstimateSummary,
    SURVEY_ESTIMATE_STORAGE_KEY,
    validateStoredSurveyEstimate,
    type StoredSurveyEstimate,
  } from '../lib/calculators/prePurchaseSurveyEstimate';
  import {
    deliveryLabels,
    formatRouteCorridor,
  } from '../lib/calculators/yachtDelivery';
  import {
    createDeliveryEstimateSummary,
    DELIVERY_ESTIMATE_STORAGE_KEY,
    validateDeliveryEstimatePayload,
    type StoredDeliveryEstimate,
  } from '../lib/calculators/yachtDeliveryEstimate';
  import {
    contactCalculatorCopy,
    contactClientCopy,
    contactFormCopy,
    serverErrorMessageKeys,
    type ContactLocale,
  } from '../i18n/contact';

  interface ContactApiResponse {
    ok: boolean;
    message: string;
    reference?: string;
    errors?: Record<string, string>;
  }

  interface TurnstileWindow extends Window {
    turnstile?: {
      reset: (container?: string | HTMLElement) => void;
    };
  }

  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');

  if (form) {
    const contactLocale: ContactLocale =
      form.dataset.locale === 'es' ? 'es' : 'en';
    const clientCopy = contactClientCopy[contactLocale];
    const submitButton = form.querySelector<HTMLButtonElement>(
      '[data-submit-button]',
    );
    const submitLabel = form.querySelector<HTMLElement>('[data-submit-label]');
    const status = form.querySelector<HTMLElement>('[data-form-status]');
    const message = form.elements.namedItem('message');
    const messageCount = form.querySelector<HTMLElement>(
      '[data-message-count]',
    );
    const attachments = form.elements.namedItem('attachments');
    const serviceField = form.elements.namedItem('service');
    const surveyEstimatePanel = form.querySelector<HTMLElement>(
      '[data-survey-estimate-summary]',
    );
    const surveyCalculatorSuggestion = form.querySelector<HTMLElement>(
      '[data-survey-calculator-suggestion]',
    );
    const deliveryEstimatePanel = form.querySelector<HTMLElement>(
      '[data-delivery-estimate-summary]',
    );
    const deliveryCalculatorSuggestion = form.querySelector<HTMLElement>(
      '[data-delivery-calculator-suggestion]',
    );
    const valuationDamageHelper = form.querySelector<HTMLElement>(
      '[data-valuation-damage-helper]',
    );
    const removeSurveyEstimateButton = form.querySelector<HTMLButtonElement>(
      '[data-remove-survey-estimate]',
    );
    const removeDeliveryEstimateButton = form.querySelector<HTMLButtonElement>(
      '[data-remove-delivery-estimate]',
    );
    let activeSurveyEstimate: StoredSurveyEstimate | null = null;
    let activeDeliveryEstimate: StoredDeliveryEstimate | null = null;
    const allowedServices = new Set(
      Array.from(
        form.querySelectorAll<HTMLOptionElement>(
          'select[name="service"] option[value]',
        ),
      )
        .map((option) => option.value)
        .filter(Boolean),
    );
    const formatCurrency = (value: number) =>
      new Intl.NumberFormat(clientCopy.locale, {
        style: 'currency',
        currency: 'EUR',
        maximumFractionDigits: 0,
      }).format(value);
    const formatDate = (value: string) =>
      new Intl.DateTimeFormat(clientCopy.locale, {
        day: 'numeric',
        month: 'long',
        year: 'numeric',
        timeZone: 'UTC',
      }).format(new Date(value));
    const formatNumber = (value: number, maximumFractionDigits = 0) =>
      value.toLocaleString(clientCopy.locale, {
        maximumFractionDigits,
      });

    const setHiddenValue = (name: string, value: string) => {
      const field = form.elements.namedItem(name);
      if (field instanceof HTMLInputElement) field.value = value;
    };

    const resetRequestMetadata = () => {
      setHiddenValue('submissionId', crypto.randomUUID());
      setHiddenValue('formStartedAt', String(Date.now()));
      setHiddenValue('pageUrl', window.location.href.slice(0, 500));
    };

    const setFieldValue = (name: string, value: unknown) => {
      if (typeof value !== 'string' || value.length === 0) return;
      const field = form.elements.namedItem(name);
      if (
        field instanceof HTMLInputElement ||
        field instanceof HTMLTextAreaElement ||
        field instanceof HTMLSelectElement
      ) {
        const maxLength =
          field instanceof HTMLSelectElement || field.maxLength < 0
            ? 5000
            : field.maxLength;
        field.value = value.slice(0, maxLength);
      }
    };

    const removeSessionValue = (key: string) => {
      try {
        sessionStorage.removeItem(key);
      } catch {
        // Storage may be unavailable without preventing normal contact use.
      }
    };

    const readSessionValue = (key: string): string | null => {
      try {
        return sessionStorage.getItem(key);
      } catch {
        return null;
      }
    };

    const applyPrefill = () => {
      const query = new URLSearchParams(window.location.search);
      const queryService = query.get('service');
      const storedRaw = readSessionValue('ays:contact-prefill');
      let stored: Record<string, unknown> = {};

      if (storedRaw) {
        try {
          const parsed: unknown = JSON.parse(storedRaw);
          if (parsed && typeof parsed === 'object' && !Array.isArray(parsed)) {
            stored = parsed as Record<string, unknown>;
          }
        } catch {
          removeSessionValue('ays:contact-prefill');
        }
      }

      const service =
        queryService && allowedServices.has(queryService)
          ? queryService
          : typeof stored.service === 'string' &&
              allowedServices.has(stored.service)
            ? stored.service
            : '';

      setFieldValue('service', service);
      setFieldValue('vesselType', query.get('vesselType') ?? stored.vesselType);
      setFieldValue(
        'vesselLength',
        query.get('vesselLength') ?? stored.vesselLength,
      );
      setFieldValue(
        'vesselLocation',
        query.get('vesselLocation') ?? stored.vesselLocation,
      );
      setFieldValue(
        'preferredDate',
        query.get('preferredDate') ?? stored.preferredDate,
      );
      setFieldValue('message', query.get('message') ?? stored.message);

      const isCalculatorRequest =
        query.get('source') === 'survey-calculator' ||
        query.get('source') === 'delivery-calculator';
      if (isCalculatorRequest) {
        setHiddenValue('source', 'contact-page');
        setHiddenValue('estimateReference', '');
        setHiddenValue('calculatorSummary', '');
        return;
      }

      const source =
        query.get('source') ??
        (typeof stored.source === 'string' ? stored.source : '');
      setHiddenValue('source', source.slice(0, 100) || 'contact-page');
      setHiddenValue(
        'estimateReference',
        (
          query.get('estimateReference') ??
          (typeof stored.estimateReference === 'string'
            ? stored.estimateReference
            : '')
        ).slice(0, 100),
      );
      setHiddenValue(
        'calculatorSummary',
        (
          query.get('calculatorSummary') ??
          (typeof stored.calculatorSummary === 'string'
            ? stored.calculatorSummary
            : '')
        ).slice(0, 4000),
      );
    };

    const setSurveyEstimateText = (selector: string, value: string) => {
      const element = surveyEstimatePanel?.querySelector<HTMLElement>(selector);
      if (element) element.textContent = value;
    };

    const updateSurveyCalculatorSuggestion = () => {
      if (!surveyCalculatorSuggestion) return;
      surveyCalculatorSuggestion.hidden =
        !(serviceField instanceof HTMLSelectElement) ||
        serviceField.value !== 'pre-purchase-survey' ||
        activeSurveyEstimate !== null;
    };

    const updateDeliveryCalculatorSuggestion = () => {
      if (!deliveryCalculatorSuggestion) return;
      deliveryCalculatorSuggestion.hidden =
        !(serviceField instanceof HTMLSelectElement) ||
        serviceField.value !== 'yacht-delivery' ||
        activeDeliveryEstimate !== null;
    };

    const updateCalculatorSuggestions = () => {
      updateSurveyCalculatorSuggestion();
      updateDeliveryCalculatorSuggestion();
      if (valuationDamageHelper) {
        valuationDamageHelper.hidden =
          !(serviceField instanceof HTMLSelectElement) ||
          serviceField.value !== 'valuation-damage-survey';
      }
    };

    const resetEstimateMetadataIfEmpty = () => {
      if (activeSurveyEstimate || activeDeliveryEstimate) return;
      setHiddenValue('estimateReference', '');
      setHiddenValue('calculatorSummary', '');
      setHiddenValue('source', 'contact-page');
    };

    const hideSurveyEstimate = () => {
      if (surveyEstimatePanel) surveyEstimatePanel.hidden = true;
      activeSurveyEstimate = null;
      resetEstimateMetadataIfEmpty();
      updateCalculatorSuggestions();
    };

    const hideDeliveryEstimate = () => {
      if (deliveryEstimatePanel) deliveryEstimatePanel.hidden = true;
      activeDeliveryEstimate = null;
      resetEstimateMetadataIfEmpty();
      updateCalculatorSuggestions();
    };

    const readSurveyEstimate = (): StoredSurveyEstimate | null => {
      const query = new URLSearchParams(window.location.search);
      const reference = query.get('estimateReference');
      if (
        query.get('source') !== 'survey-calculator' ||
        query.get('service') !== 'pre-purchase-survey' ||
        !reference
      ) {
        return null;
      }

      const storedRaw = readSessionValue(SURVEY_ESTIMATE_STORAGE_KEY);
      if (!storedRaw) return null;

      try {
        const parsed: unknown = JSON.parse(storedRaw);
        const validation = validateStoredSurveyEstimate(parsed, reference);
        if (!validation.isValid) {
          removeSessionValue(SURVEY_ESTIMATE_STORAGE_KEY);
          return null;
        }
        return validation.payload;
      } catch {
        removeSessionValue(SURVEY_ESTIMATE_STORAGE_KEY);
        return null;
      }
    };

    const applySurveyEstimate = () => {
      hideSurveyEstimate();
      const estimate = readSurveyEstimate();
      if (!estimate || !surveyEstimatePanel) {
        updateCalculatorSuggestions();
        return;
      }

      activeSurveyEstimate = estimate;
      setFieldValue('service', estimate.service);
      setFieldValue(
        'vesselType',
        estimate.vesselType === 'sailing' ? 'sailing-yacht' : 'motor-yacht',
      );
      setFieldValue('vesselLength', String(estimate.loaMetres));
      setFieldValue('vesselLocation', estimate.location);
      setHiddenValue('source', estimate.source);
      setHiddenValue('estimateReference', estimate.reference);
      setHiddenValue(
        'calculatorSummary',
        createSurveyEstimateSummary(estimate).slice(0, 4000),
      );

      setSurveyEstimateText(
        '[data-contact-estimate-reference]',
        estimate.reference,
      );
      setSurveyEstimateText(
        '[data-contact-estimate-price]',
        formatCurrency(estimate.estimatedPriceEur),
      );
      setSurveyEstimateText(
        '[data-contact-estimate-date]',
        formatDate(estimate.createdAt),
      );
      setSurveyEstimateText(
        '[data-contact-estimate-loa]',
        `${formatNumber(estimate.loaMetres, 1)} ${clientCopy.metres}`,
      );
      setSurveyEstimateText(
        '[data-contact-estimate-vessel]',
        contactLocale === 'es'
          ? contactCalculatorCopy.es.survey.vesselType[estimate.vesselType]
          : surveyLabels.vesselType[estimate.vesselType],
      );
      setSurveyEstimateText(
        '[data-contact-estimate-package]',
        contactLocale === 'es'
          ? contactCalculatorCopy.es.survey.packageType[estimate.packageType]
          : surveyLabels.packageType[estimate.packageType],
      );
      setSurveyEstimateText(
        '[data-contact-estimate-hull]',
        contactLocale === 'es'
          ? contactCalculatorCopy.es.survey.hullInspection[
              estimate.hullInspection
            ]
          : surveyLabels.hullInspection[estimate.hullInspection],
      );
      setSurveyEstimateText(
        '[data-contact-estimate-location]',
        estimate.location,
      );
      setSurveyEstimateText(
        '[data-contact-estimate-discount]',
        formatCurrency(estimate.packageDiscountEur),
      );

      const locationRow = surveyEstimatePanel.querySelector<HTMLElement>(
        '[data-contact-estimate-location-row]',
      );
      if (locationRow) locationRow.hidden = estimate.location.length === 0;
      const discountRow = surveyEstimatePanel.querySelector<HTMLElement>(
        '[data-contact-estimate-discount-row]',
      );
      if (discountRow) {
        discountRow.hidden = estimate.packageDiscountEur === 0;
      }

      const items = surveyEstimatePanel.querySelector<HTMLUListElement>(
        '[data-contact-estimate-items]',
      );
      if (items) {
        items.replaceChildren(
          ...estimate.includedItems.map((item) => {
            const listItem = document.createElement('li');
            listItem.textContent =
              contactLocale === 'es'
                ? (contactCalculatorCopy.es.survey.items[
                    item as keyof typeof contactCalculatorCopy.es.survey.items
                  ] ?? item)
                : item;
            return listItem;
          }),
        );
      }

      surveyEstimatePanel.hidden = false;
      updateCalculatorSuggestions();
    };

    const setDeliveryEstimateText = (selector: string, value: string) => {
      const element =
        deliveryEstimatePanel?.querySelector<HTMLElement>(selector);
      if (element) element.textContent = value;
    };

    const readDeliveryEstimate = (): StoredDeliveryEstimate | null => {
      const query = new URLSearchParams(window.location.search);
      const reference = query.get('estimateReference');
      if (
        query.get('source') !== 'delivery-calculator' ||
        query.get('service') !== 'yacht-delivery' ||
        !reference
      ) {
        return null;
      }

      const storedRaw = readSessionValue(DELIVERY_ESTIMATE_STORAGE_KEY);
      if (!storedRaw) return null;

      try {
        const parsed: unknown = JSON.parse(storedRaw);
        const validation = validateDeliveryEstimatePayload(parsed, reference);
        if (!validation.isValid) {
          removeSessionValue(DELIVERY_ESTIMATE_STORAGE_KEY);
          return null;
        }
        return validation.payload;
      } catch {
        removeSessionValue(DELIVERY_ESTIMATE_STORAGE_KEY);
        return null;
      }
    };

    const applyDeliveryEstimate = () => {
      hideDeliveryEstimate();
      const estimate = readDeliveryEstimate();
      if (!estimate || !deliveryEstimatePanel) {
        updateCalculatorSuggestions();
        return;
      }

      activeDeliveryEstimate = estimate;
      setFieldValue('service', estimate.service);
      setFieldValue(
        'vesselType',
        estimate.yachtType === 'sailing' ? 'sailing-yacht' : 'motor-yacht',
      );
      setFieldValue('vesselLocation', estimate.departurePortName);
      setHiddenValue('source', estimate.source);
      setHiddenValue('estimateReference', estimate.reference);
      setHiddenValue(
        'calculatorSummary',
        createDeliveryEstimateSummary(estimate).slice(0, 4000),
      );

      setDeliveryEstimateText(
        '[data-contact-delivery-reference]',
        estimate.reference,
      );
      setDeliveryEstimateText(
        '[data-contact-delivery-date]',
        formatDate(estimate.createdAt),
      );
      setDeliveryEstimateText(
        '[data-contact-delivery-departure]',
        estimate.departurePortName,
      );
      setDeliveryEstimateText(
        '[data-contact-delivery-destination]',
        estimate.destinationPortName,
      );
      setDeliveryEstimateText(
        '[data-contact-delivery-distance]',
        `${formatNumber(estimate.distanceNm)} ${clientCopy.nauticalMiles}`,
      );
      setDeliveryEstimateText(
        '[data-contact-delivery-price]',
        formatCurrency(estimate.estimatedStartingFeeEur),
      );
      setDeliveryEstimateText(
        '[data-contact-delivery-yacht-type]',
        contactLocale === 'es'
          ? contactCalculatorCopy.es.delivery.yachtType[estimate.yachtType]
          : deliveryLabels.yachtType[estimate.yachtType],
      );
      setDeliveryEstimateText(
        '[data-contact-delivery-length-band]',
        contactLocale === 'es'
          ? contactCalculatorCopy.es.delivery.lengthBand[estimate.lengthBand]
          : deliveryLabels.lengthBand[estimate.lengthBand],
      );
      setDeliveryEstimateText(
        '[data-contact-delivery-complexity]',
        contactLocale === 'es'
          ? contactCalculatorCopy.es.delivery.complexity[estimate.complexity]
          : deliveryLabels.complexity[estimate.complexity],
      );
      setDeliveryEstimateText(
        '[data-contact-delivery-urgency]',
        contactLocale === 'es'
          ? contactCalculatorCopy.es.delivery.urgency[estimate.urgency]
          : deliveryLabels.urgency[estimate.urgency],
      );
      setDeliveryEstimateText(
        '[data-contact-delivery-corridor]',
        formatRouteCorridor(estimate.routePathKeys),
      );

      deliveryEstimatePanel.hidden = false;
      updateCalculatorSuggestions();
    };

    const clearErrors = () => {
      form
        .querySelectorAll<HTMLElement>('[data-field-error]')
        .forEach((node) => {
          node.textContent = '';
        });
      form
        .querySelectorAll<HTMLElement>('[aria-invalid="true"]')
        .forEach((field) => field.removeAttribute('aria-invalid'));
      if (status) {
        status.textContent = '';
        status.className = 'form-status';
      }
    };

    const showErrors = (errors: Record<string, string>) => {
      let firstInvalidName = '';

      Object.entries(errors).forEach(([name, error]) => {
        const errorNode = form.querySelector<HTMLElement>(
          `[data-field-error="${CSS.escape(name)}"]`,
        );
        if (errorNode) errorNode.textContent = error;

        const field = form.elements.namedItem(name);
        if (
          field instanceof HTMLInputElement ||
          field instanceof HTMLTextAreaElement ||
          field instanceof HTMLSelectElement
        ) {
          field.setAttribute('aria-invalid', 'true');
          if (!firstInvalidName) firstInvalidName = name;
        } else if (name === 'verification') {
          if (!firstInvalidName) firstInvalidName = name;
        }
      });

      const firstInvalidField =
        firstInvalidName === 'verification'
          ? form.querySelector<HTMLElement>('[data-turnstile-container]')
          : form.elements.namedItem(firstInvalidName);

      if (
        firstInvalidField instanceof HTMLElement &&
        !(firstInvalidField instanceof RadioNodeList)
      ) {
        firstInvalidField.focus();
      }
    };

    const translateServerError = (field: string, messageText: string) => {
      if (contactLocale !== 'es') return messageText;
      const key =
        serverErrorMessageKeys[
          messageText as keyof typeof serverErrorMessageKeys
        ];
      if (key) return clientCopy.errors[key];

      const fieldError =
        clientCopy.errors[field as keyof typeof clientCopy.errors];
      return fieldError ?? clientCopy.errors.generic;
    };

    const validateVisibleFields = (): Record<string, string> => {
      const errors: Record<string, string> = {};
      const name = form.elements.namedItem('name');
      const email = form.elements.namedItem('email');
      const phone = form.elements.namedItem('phone');
      const service = form.elements.namedItem('service');
      const vesselType = form.elements.namedItem('vesselType');
      const vesselLength = form.elements.namedItem('vesselLength');
      const vesselLocation = form.elements.namedItem('vesselLocation');
      const preferredDate = form.elements.namedItem('preferredDate');
      const consent = form.elements.namedItem('consent');

      if (
        !(name instanceof HTMLInputElement) ||
        name.value.trim().length < 2 ||
        name.value.trim().length > 100
      ) {
        errors.name = clientCopy.errors.name;
      }
      if (
        !(email instanceof HTMLInputElement) ||
        !email.validity.valid ||
        email.value.trim().length === 0
      ) {
        errors.email = clientCopy.errors.email;
      }
      if (
        phone instanceof HTMLInputElement &&
        (phone.value.length > 50 ||
          (phone.value.trim().length > 0 &&
            !/^[+\d\s()./-]+$/u.test(phone.value.trim())))
      ) {
        errors.phone = clientCopy.errors.phone;
      }
      if (
        service instanceof HTMLSelectElement &&
        service.value.length > 0 &&
        !allowedServices.has(service.value)
      ) {
        errors.service = clientCopy.errors.service;
      }
      if (
        vesselType instanceof HTMLSelectElement &&
        vesselType.value.length > 0 &&
        !['sailing-yacht', 'motor-yacht', 'catamaran', 'other'].includes(
          vesselType.value,
        )
      ) {
        errors.vesselType = clientCopy.errors.vesselType;
      }
      if (
        vesselLength instanceof HTMLInputElement &&
        vesselLength.value.length > 0 &&
        (!vesselLength.validity.valid ||
          Number(vesselLength.value) < 1 ||
          Number(vesselLength.value) > 99)
      ) {
        errors.vesselLength = clientCopy.errors.vesselLength;
      }
      if (
        vesselLocation instanceof HTMLInputElement &&
        vesselLocation.value.length > 120
      ) {
        errors.vesselLocation = clientCopy.errors.vesselLocation;
      }
      if (
        preferredDate instanceof HTMLInputElement &&
        preferredDate.value.length > 0 &&
        !preferredDate.validity.valid
      ) {
        errors.preferredDate = clientCopy.errors.preferredDate;
      }
      if (
        !(message instanceof HTMLTextAreaElement) ||
        message.value.trim().length < 20 ||
        message.value.trim().length > 5000
      ) {
        errors.message = clientCopy.errors.message;
      }
      if (!(consent instanceof HTMLInputElement) || !consent.checked) {
        errors.consent = clientCopy.errors.consent;
      }

      return errors;
    };

    const setStatus = (
      kind: 'error' | 'success',
      heading: string,
      messageText: string,
    ) => {
      if (!status) return;
      status.className = `form-status form-status-${kind}`;
      const title = document.createElement('strong');
      title.className = 'form-status-heading';
      title.textContent = heading;
      const messageNode = document.createElement('span');
      messageNode.textContent = messageText;
      status.replaceChildren(title, messageNode);
      status.focus();
    };

    const updateMessageCount = () => {
      if (!(message instanceof HTMLTextAreaElement) || !messageCount) return;
      messageCount.textContent = `${message.value.length.toLocaleString(
        clientCopy.locale,
      )} / ${Number(5000).toLocaleString(clientCopy.locale)}`;
    };

    const validateAttachments = (): string | undefined => {
      if (!(attachments instanceof HTMLInputElement) || !attachments.files) {
        return undefined;
      }

      const files = Array.from(attachments.files);
      const allowedTypes = new Set([
        'application/pdf',
        'image/jpeg',
        'image/png',
        'image/webp',
      ]);
      const totalSize = files.reduce((sum, file) => sum + file.size, 0);

      if (files.length > 3) return clientCopy.errors.attachmentsCount;
      if (files.some((file) => !allowedTypes.has(file.type))) {
        return clientCopy.errors.attachmentsType;
      }
      if (files.some((file) => file.size > 2_000_000)) {
        return clientCopy.errors.attachmentsFileSize;
      }
      if (totalSize > 3_000_000) {
        return clientCopy.errors.attachmentsTotalSize;
      }

      return undefined;
    };

    if (message instanceof HTMLTextAreaElement) {
      message.addEventListener('input', updateMessageCount);
    }
    if (serviceField instanceof HTMLSelectElement) {
      serviceField.addEventListener('change', () => {
        if (
          activeSurveyEstimate &&
          serviceField.value !== 'pre-purchase-survey'
        ) {
          removeSessionValue(SURVEY_ESTIMATE_STORAGE_KEY);
          hideSurveyEstimate();
        } else if (
          activeDeliveryEstimate &&
          serviceField.value !== 'yacht-delivery'
        ) {
          removeSessionValue(DELIVERY_ESTIMATE_STORAGE_KEY);
          hideDeliveryEstimate();
        } else {
          updateCalculatorSuggestions();
        }
      });
    }
    removeSurveyEstimateButton?.addEventListener('click', () => {
      removeSessionValue(SURVEY_ESTIMATE_STORAGE_KEY);
      hideSurveyEstimate();
      surveyCalculatorSuggestion
        ?.querySelector<HTMLAnchorElement>('a')
        ?.focus();
    });
    removeDeliveryEstimateButton?.addEventListener('click', () => {
      removeSessionValue(DELIVERY_ESTIMATE_STORAGE_KEY);
      hideDeliveryEstimate();
      deliveryCalculatorSuggestion
        ?.querySelector<HTMLAnchorElement>('a')
        ?.focus();
    });
    updateMessageCount();
    resetRequestMetadata();
    applyPrefill();
    applySurveyEstimate();
    applyDeliveryEstimate();
    updateMessageCount();

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      clearErrors();

      const attachmentError = validateAttachments();
      if (attachmentError) {
        showErrors({ attachments: attachmentError });
        return;
      }

      const visibleErrors = validateVisibleFields();
      if (Object.keys(visibleErrors).length > 0) {
        showErrors(visibleErrors);
        return;
      }

      const formData = new FormData(form);
      const turnstileToken = formData.get('cf-turnstile-response');
      if (typeof turnstileToken !== 'string' || turnstileToken.length === 0) {
        showErrors({
          verification: clientCopy.errors.verification,
        });
        return;
      }

      if (submitButton) submitButton.disabled = true;
      if (submitLabel) {
        submitLabel.textContent =
          contactLocale === 'es'
            ? contactFormCopy.es.submitting
            : contactFormCopy.en.submitting;
      }

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body: formData,
          headers: {
            Accept: 'application/json',
          },
        });
        const payload = (await response.json()) as ContactApiResponse;

        if (!response.ok || !payload.ok) {
          const translatedErrors = Object.fromEntries(
            Object.entries(payload.errors ?? {}).map(([field, error]) => [
              field,
              translateServerError(field, error),
            ]),
          );
          showErrors(translatedErrors);
          if (contactLocale === 'es') {
            setStatus(
              'error',
              clientCopy.errorHeading,
              clientCopy.errorMessage,
            );
          } else if (status) {
            status.className = 'form-status form-status-error';
            status.textContent =
              payload.message ||
              'Your enquiry could not be sent. Please try again or contact us directly.';
            status.focus();
          }
          return;
        }

        if (contactLocale === 'es') {
          const referenceText = payload.reference
            ? ` ${clientCopy.reference}: ${payload.reference}.`
            : '';
          setStatus(
            'success',
            clientCopy.successHeading,
            `${clientCopy.successMessage}${referenceText}`,
          );
        } else if (status) {
          status.className = 'form-status form-status-success';
          status.textContent = payload.reference
            ? `${payload.message} Reference: ${payload.reference}.`
            : payload.message;
          status.focus();
        }

        form.reset();
        removeSessionValue('ays:contact-prefill');
        removeSessionValue(SURVEY_ESTIMATE_STORAGE_KEY);
        removeSessionValue(DELIVERY_ESTIMATE_STORAGE_KEY);
        resetRequestMetadata();
        applyPrefill();
        applySurveyEstimate();
        applyDeliveryEstimate();
        updateMessageCount();
      } catch {
        if (contactLocale === 'es') {
          setStatus(
            'error',
            clientCopy.errorHeading,
            clientCopy.connectionError,
          );
        } else if (status) {
          status.className = 'form-status form-status-error';
          status.textContent =
            'The connection was interrupted. Please try again or contact us by phone, WhatsApp or email.';
          status.focus();
        }
      } finally {
        if (submitButton) submitButton.disabled = false;
        if (submitLabel) {
          submitLabel.textContent =
            contactLocale === 'es'
              ? contactFormCopy.es.submit
              : contactFormCopy.en.submit;
        }
        (window as TurnstileWindow).turnstile?.reset();
      }
    });
  }
</script>
