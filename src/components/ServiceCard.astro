---
interface Props {
  title: string;
  description: string;
  href: string;
  linkLabel: string;
}

const { title, description, href, linkLabel } = Astro.props;
---

<article
  class="group flex h-full flex-col border border-graphite/15 bg-white p-6 shadow-[0_18px_45px_rgba(10,29,47,0.06)] transition-transform duration-200 hover:-translate-y-1"
>
  <h3 class="font-display text-xl font-bold text-navy">{title}</h3>
  <p class="mt-3 grow leading-7 text-graphite/80">{description}</p>
  <a
    class="mt-6 font-semibold text-navy underline-offset-4 group-hover:underline"
    href={href}
  >
    {linkLabel}
  </a>
</article>
