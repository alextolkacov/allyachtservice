---
import { siteConfig } from '../data/site';
import type { Locale } from '../data/languages';
import { getSharedUi } from '../i18n/ui';

interface Props {
  theme?: 'light' | 'dark';
  showLabels?: boolean;
  locale?: Locale;
}

const { theme = 'dark', showLabels = false, locale = 'en' } = Astro.props;
const ui = getSharedUi(locale);
---

<ul class:list={['social-links', `social-links-${theme}`]} role="list">
  <li>
    <a
      href={siteConfig.social.instagram}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={`All Yacht Service ${locale === 'es' ? 'en' : 'on'} Instagram, ${ui.opensNewTab}`}
    >
      <svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20">
        <rect x="3" y="3" width="18" height="18" rx="5"></rect>
        <circle cx="12" cy="12" r="4"></circle>
        <circle class="social-icon-fill" cx="17.4" cy="6.7" r="1"></circle>
      </svg>
      {showLabels && <span>Instagram</span>}
    </a>
  </li>
  <li>
    <a
      href={siteConfig.social.linkedin}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={`All Yacht Service ${locale === 'es' ? 'en' : 'on'} LinkedIn, ${ui.opensNewTab}`}
    >
      <svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20">
        <rect x="4" y="9" width="4" height="11"></rect>
        <circle class="social-icon-fill" cx="6" cy="5.7" r="2"></circle>
        <path
          d="M12 20V9h4v1.7c1-1.4 2.3-2.1 3.8-2.1 3 0 4.2 2 4.2 5.4v6h-4v-5.3c0-1.7-.6-2.6-1.9-2.6-1.5 0-2.1 1.1-2.1 3V20z"
        ></path>
      </svg>
      {showLabels && <span>LinkedIn</span>}
    </a>
  </li>
</ul>
