---
import PrePurchaseSurveyCalculator from '../components/PrePurchaseSurveyCalculator.astro';
import { prePurchaseSurveyCalculatorPage as page } from '../data/pre-purchase-survey-calculator';
import ServiceLayout from '../layouts/ServiceLayout.astro';
import {
  businessEntityId,
  toAbsoluteUrl,
  type StructuredData,
} from '../utils/seo';

const pageUrl = toAbsoluteUrl(page.pathname);
const webPageSchema: StructuredData = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': `${pageUrl}#page`,
  url: pageUrl,
  name: page.title,
  description: page.description,
  about: {
    '@id': businessEntityId,
  },
};
---

<ServiceLayout
  title={page.title}
  description={page.description}
  locale="en"
  routeId="prePurchaseSurveyCalculator"
  pathname={page.pathname}
  heading={page.heading}
  eyebrow={page.eyebrow}
  summary={page.summary}
  heroImage={page.heroImage}
  socialImageAlt={page.socialImageAlt}
  breadcrumbs={page.breadcrumbs}
  primaryCta={page.primaryCta}
  secondaryCta={page.secondaryCta}
  relatedServices={page.relatedServices}
  finalCta={page.finalCta}
  structuredData={webPageSchema}
>
  <section aria-labelledby="initial-estimate-heading">
    <h2 id="initial-estimate-heading">Calculate an Initial Survey Estimate</h2>
    <p>
      Use the calculator to obtain an initial indication of the professional fee
      for a pre-purchase yacht survey. Select the vessel length, yacht type and
      inspection scope that most closely match your requirements.
    </p>
    <p>
      The estimate is intended to support initial planning. A formal quotation
      will be provided after the yacht details, location, access and required
      scope have been reviewed.
    </p>
  </section>

  <PrePurchaseSurveyCalculator />

  <section aria-labelledby="included-heading">
    <h2 id="included-heading">What Can Be Included?</h2>
    <ul class="service-check-list">
      {page.includedItems.map((item) => <li>{item}</li>)}
    </ul>
    <p>
      Learn more about the inspection process and reporting on the
      {' '}<a class="text-link" href="/pre-purchase-survey"
        >Pre-Purchase Yacht Survey service page</a
      >.
    </p>
  </section>

  <section aria-labelledby="quotation-difference-heading">
    <h2 id="quotation-difference-heading">
      Why Can the Final Quotation Differ?
    </h2>
    <p>
      The calculator uses approved length- and scope-based pricing rules, but it
      cannot fully assess every feature that can affect the final work required:
    </p>
    <ul class="defect-grid">
      {page.quotationFactors.map((factor) => <li>{factor}</li>)}
    </ul>
  </section>

  <section aria-labelledby="next-steps-heading">
    <h2 id="next-steps-heading">What Happens Next?</h2>
    <ol class="process-list">
      {
        page.nextSteps.map((step, index) => (
          <li>
            <div>
              <span aria-hidden="true">
                {String(index + 1).padStart(2, '0')}
              </span>
            </div>
            <div>
              <h3>{step.title}</h3>
              <p>{step.description}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </section>
</ServiceLayout>
