---
import PolicyPageLayout from '../components/PolicyPageLayout.astro';
import { legalConfig } from '../data/legal';

const toc = [
  { id: 'operator', label: 'Website operator' },
  { id: 'professional-information', label: 'Professional information' },
  { id: 'purpose', label: 'Website purpose' },
  { id: 'contact-details', label: 'Contact' },
  { id: 'intellectual-property', label: 'Intellectual property' },
  { id: 'external-links', label: 'External links' },
  { id: 'availability', label: 'Website availability and accuracy' },
  { id: 'applicable-law', label: 'Applicable law' },
] as const;
---

<PolicyPageLayout
  title="Legal Notice | All Yacht Service"
  description="Legal and website-operator information for the All Yacht Service website."
  heading="Legal Notice"
  intro="This notice provides verified operator, contact and website-use information for the All Yacht Service website."
  pathname="/legal-notice"
  routeId="legalNotice"
  toc={toc}
>
  <section id="operator" aria-labelledby="operator-heading">
    <h2 id="operator-heading">1. Website Operator</h2>
    {
      legalConfig.legalOperatorName ? (
        <p>The verified website-operator details are:</p>
      ) : (
        <p>
          The final legal operator identity and publication requirements are
          being confirmed. Unverified identity, tax and registration fields are
          not displayed. The verified public details are:
        </p>
      )
    }
    <dl class="policy-facts">
      {
        legalConfig.legalOperatorName && (
          <div>
            <>
              <dt>Legal operator</dt>
              <dd>{legalConfig.legalOperatorName}</dd>
            </>
          </div>
        )
      }
      {
        legalConfig.operatorType === 'natural-person' && (
          <div>
            <>
              <dt>Operator status</dt>
              <dd>Natural person</dd>
            </>
          </div>
        )
      }
      {
        legalConfig.legalForm && (
          <div>
            <>
              <dt>Legal form</dt>
              <dd>{legalConfig.legalForm}</dd>
            </>
          </div>
        )
      }
      <div><dt>Trading name</dt><dd>{legalConfig.tradingName}</dd></div>
      {
        legalConfig.taxId && (
          <div>
            <>
              <dt>Tax identification</dt>
              <dd>{legalConfig.taxId}</dd>
            </>
          </div>
        )
      }
      {
        legalConfig.registeredAddress && (
          <div>
            <>
              <dt>Registered address</dt>
              <dd>{legalConfig.registeredAddress}</dd>
            </>
          </div>
        )
      }
      <div>
        <dt>Public office</dt><dd>{legalConfig.publicOfficeAddress}</dd>
      </div>
      <div>
        <dt>Email</dt><dd>
          <a href={`mailto:${legalConfig.email}`}>{legalConfig.email}</a>
        </dd>
      </div>
      <div>
        <dt>Telephone</dt><dd>
          <a href="tel:+34695718540">{legalConfig.phone}</a>
        </dd>
      </div>
      <div>
        <dt>Domain</dt><dd>
          <a href={legalConfig.websiteUrl}>{legalConfig.websiteUrl}</a>
        </dd>
      </div>
      {
        legalConfig.registryName && legalConfig.registryNumber && (
          <div>
            <>
              <dt>Registration</dt>
              <dd>
                {legalConfig.registryName}: {legalConfig.registryNumber}
              </dd>
            </>
          </div>
        )
      }
    </dl>
  </section>

  <section
    id="professional-information"
    aria-labelledby="professional-information-heading"
  >
    <h2 id="professional-information-heading">2. Professional Information</h2>
    <p>
      Aleksandrs Tolkacovs is an IIMS-Certified Yacht and Small Craft Marine
      Surveyor and licensed captain. This statement does not describe IIMS as a
      Spanish regulator, assert that yacht surveying is a regulated Spanish
      profession, or make any claim about professional-liability insurance.
      Further professional background is available on the
      <a href="/about-us">About Us page</a>.
    </p>
  </section>

  <section id="purpose" aria-labelledby="purpose-heading">
    <h2 id="purpose-heading">3. Website Purpose</h2>
    <p>
      This website provides information about yacht surveys, yacht delivery,
      buyer support, educational yacht-survey articles, non-binding cost
      calculators and links to external yacht-brokerage listings.
    </p>
  </section>

  <section id="contact-details" aria-labelledby="contact-details-heading">
    <h2 id="contact-details-heading">4. Contact</h2>
    <p>
      Questions about this website may be sent to
      <a href={`mailto:${legalConfig.email}`}>{legalConfig.email}</a>, raised by
      phone or WhatsApp at <a href="tel:+34695718540">{legalConfig.phone}</a>,
      or submitted through the <a href="/contact">Contact page</a>.
    </p>
  </section>

  <section
    id="intellectual-property"
    aria-labelledby="intellectual-property-heading"
  >
    <h2 id="intellectual-property-heading">5. Intellectual Property</h2>
    <p>
      Website text, design, branding, reports and original images are protected
      where applicable. Third-party material remains subject to the rights and
      permissions that apply to it. In particular, third-party brokerage imagery
      is not claimed as original All Yacht Service material merely because it
      appears with permission or links to an external listing.
    </p>
  </section>

  <section id="external-links" aria-labelledby="external-links-heading">
    <h2 id="external-links-heading">6. External Links</h2>
    <p>
      External websites control their own content, terms, availability and
      privacy practices. Premium Yachts Spain maintains its live listings and
      brokerage information; All Yacht Service does not control that external
      inventory.
    </p>
  </section>

  <section id="availability" aria-labelledby="availability-heading">
    <h2 id="availability-heading">7. Website Availability and Accuracy</h2>
    <p>
      Reasonable efforts are made to maintain accurate and available
      information, but website content may become outdated or temporarily
      unavailable. Details should be confirmed for an individual assignment.
      Nothing in this notice excludes liability or mandatory rights where
      exclusion is not lawful.
    </p>
  </section>

  <section id="applicable-law" aria-labelledby="applicable-law-heading">
    <h2 id="applicable-law-heading">8. Applicable Law</h2>
    {
      legalConfig.applicableLawText ? (
        <p>{legalConfig.applicableLawText}</p>
      ) : (
        <p>
          Final applicable-law and jurisdiction wording is awaiting confirmation
          of the legal operator and intended client-contract structure. This
          non-indexable draft does not impose a jurisdiction clause.
        </p>
      )
    }
  </section>
</PolicyPageLayout>
