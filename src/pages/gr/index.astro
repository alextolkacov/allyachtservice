---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="All Yacht Service | Ελληνικά"
  description="Προσωρινή ελληνική αρχική σελίδα της All Yacht Service. Το περιεχόμενο εκκρεμεί."
  locale="gr"
  routeId="home"
  pathname="/gr"
>
  <section class="site-container py-20 sm:py-28">
    <h1
      class="max-w-4xl font-display text-4xl leading-tight font-bold text-navy sm:text-6xl"
    >
      Ιστότοπος της All Yacht Service
    </h1>
    <p class="development-notice mt-10 max-w-2xl" role="status">
      Το περιεχόμενο εκκρεμεί
    </p>
  </section>
</BaseLayout>
