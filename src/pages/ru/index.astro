---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="All Yacht Service | Русский"
  description="Временная русскоязычная главная страница All Yacht Service. Содержание готовится."
  locale="ru"
  routeId="home"
  pathname="/ru"
>
  <section class="site-container py-20 sm:py-28">
    <h1
      class="max-w-4xl font-display text-4xl leading-tight font-bold text-navy sm:text-6xl"
    >
      Сайт All Yacht Service
    </h1>
    <p class="development-notice mt-10 max-w-2xl" role="status">
      Содержание готовится
    </p>
  </section>
</BaseLayout>
