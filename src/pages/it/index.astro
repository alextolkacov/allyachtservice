---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="All Yacht Service | Italiano"
  description="Homepage temporanea di All Yacht Service in italiano. Contenuto in attesa."
  locale="it"
  routeId="home"
  pathname="/it"
>
  <section class="site-container py-20 sm:py-28">
    <h1
      class="max-w-4xl font-display text-4xl leading-tight font-bold text-navy sm:text-6xl"
    >
      Sito web di All Yacht Service
    </h1>
    <p class="development-notice mt-10 max-w-2xl" role="status">
      Contenuto in attesa
    </p>
  </section>
</BaseLayout>
