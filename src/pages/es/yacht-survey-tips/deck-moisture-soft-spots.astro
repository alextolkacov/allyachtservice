---
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import { aboutUsPage } from '../../../data/about-us';
import { spanishDeckMoistureSoftSpotsArticle as article } from '../../../data/es/yacht-survey-tips/deck-moisture-soft-spots';
import { siteConfig } from '../../../data/site';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import {
  businessEntityId,
  toAbsoluteUrl,
  type StructuredData,
} from '../../../utils/seo';

const pageUrl = toAbsoluteUrl(article.pathname);
const pageId = `${pageUrl}#page`;
const articleId = `${pageUrl}#article`;
const imageUrl = toAbsoluteUrl(article.image.src);
const personId = new URL(aboutUsPage.person.id, siteConfig.url).toString();

const webPageSchema: StructuredData = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': pageId,
  url: pageUrl,
  name: article.seoTitle,
  description: article.metaDescription,
  inLanguage: 'es',
  mainEntity: {
    '@id': articleId,
  },
  about: {
    '@id': businessEntityId,
  },
};

const articleSchema: StructuredData = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  '@id': articleId,
  headline: article.title,
  description: article.description,
  url: pageUrl,
  mainEntityOfPage: {
    '@id': pageId,
  },
  datePublished: article.publicationDateTime,
  dateModified: article.modifiedDateTime,
  articleSection: article.category,
  timeRequired: article.timeRequired,
  image: imageUrl,
  inLanguage: 'es',
  author: {
    '@type': 'Person',
    '@id': personId,
    name: article.author.name,
    jobTitle: article.author.professionalDescription,
  },
  publisher: {
    '@id': businessEntityId,
  },
};
---

<BaseLayout
  title={article.seoTitle}
  description={article.metaDescription}
  locale="es"
  routeId="deckMoistureSoftSpots"
  pathname={article.pathname}
  imagePath={article.image.src}
  imageAlt={article.socialImageAlt}
  structuredData={[webPageSchema, articleSchema]}
  openGraphType="article"
  articlePublishedTime={article.publicationDateTime}
  articleModifiedTime={article.modifiedDateTime}
  articleSection={article.category}
  articleAuthor={article.author.name}
>
  <article class="survey-guide">
    <header class="survey-guide-header">
      <div class="site-container">
        <Breadcrumbs items={article.breadcrumbs} ariaLabel="Migas de pan" />
        <div class="survey-guide-header-grid">
          <div class="survey-guide-heading">
            <p class="eyebrow">{article.category}</p>
            <h1>{article.title}</h1>
            <p class="survey-guide-standfirst">{article.standfirst}</p>
            <dl class="survey-guide-meta">
              <div>
                <dt>Publicado</dt>
                <dd>
                  <time datetime={article.publicationDateTime}>
                    {article.publicationDate}
                  </time>
                </dd>
              </div>
              <div>
                <dt>Tiempo de lectura</dt>
                <dd>5 minutos de lectura</dd>
              </div>
              <div>
                <dt>Autor</dt>
                <dd>
                  Por {article.author.name}
                  <span class="survey-guide-author-description">
                    {article.author.professionalDescription}
                  </span>
                </dd>
              </div>
            </dl>
          </div>

          <figure class="survey-guide-figure">
            <img
              src={article.image.src}
              alt={article.image.alt}
              width={article.image.width}
              height={article.image.height}
              loading="eager"
              fetchpriority="high"
            />
            <figcaption>{article.imageCaption}</figcaption>
          </figure>
        </div>
      </div>
    </header>

    <div class="survey-guide-body">
      <div class="site-container survey-guide-reading-width">
        <section
          class="survey-guide-introduction"
          aria-labelledby="article-introduction-heading"
        >
          <h2 id="article-introduction-heading" class="sr-only">
            Introducción
          </h2>
          <p>
            Muchas cubiertas de yates de PRFV utilizan una construcción tipo
            sándwich. Un material ligero de núcleo queda adherido entre las
            capas interior y exterior del laminado para aumentar la rigidez sin
            añadir un peso excesivo.
          </p>
          <p>
            Cuando el agua atraviesa herrajes mal sellados, un laminado dañado o
            zonas reparadas anteriormente, puede penetrar en el núcleo.
          </p>
          <p>
            La superficie visible de la cubierta puede seguir pareciendo
            aceptable aunque exista humedad debajo.
          </p>
          <ul class="survey-guide-key-list">
            {article.keyInterpretationPoints.map((point) => <li>{point}</li>)}
          </ul>
        </section>

        <section aria-labelledby="why-moisture-matters">
          <h2 id="why-moisture-matters">
            1. Por qué importa la humedad en la cubierta de un yate
          </h2>
          <p>Una exposición prolongada a la humedad puede contribuir a:</p>
          <ul class="survey-guide-list-grid">
            {
              article.moistureConsequences.map((consequence) => (
                <li>{consequence}</li>
              ))
            }
          </ul>
          <p>
            La importancia depende del material del núcleo, la duración de la
            exposición, la superficie afectada, las cargas, la calidad de
            construcción y si el laminado permanece firmemente adherido.
          </p>
          <p>
            Un núcleo húmedo no significa automáticamente que todas las zonas
            afectadas deban sustituirse. Las evidencias y la construcción del
            yate deben evaluarse conjuntamente.
          </p>
        </section>

        <section aria-labelledby="how-moisture-enters">
          <h2 id="how-moisture-enters">
            2. Cómo entra la humedad en una cubierta con núcleo
          </h2>
          <p>
            El agua suele entrar alrededor de penetraciones o herrajes cuyo
            sellado ha fallado, envejecido o sido alterado. Entre los posibles
            puntos de entrada se encuentran:
          </p>
          <ul class="survey-guide-list-grid">
            {
              article.moistureEntryPoints.map((entryPoint) => (
                <li>{entryPoint}</li>
              ))
            }
          </ul>
          <p>
            El punto visible de la filtración y la concentración de humedad
            pueden no coincidir, ya que el agua puede desplazarse por huecos,
            orificios de fijación o partes dañadas del núcleo.
          </p>
        </section>

        <section aria-labelledby="warning-signs">
          <h2 id="warning-signs">3. Señales que un comprador puede observar</h2>
          <ul class="survey-guide-list-grid">
            {article.warningSigns.map((warningSign) => <li>{warningSign}</li>)}
          </ul>
          <p>
            Estas señales justifican una investigación adicional, pero ninguna
            confirma por sí sola la construcción, la profundidad ni toda la
            extensión de un posible daño.
          </p>
          <p>
            El comprador no debe realizar golpes agresivos, taladros ni otras
            pruebas destructivas. Estos métodos pueden dañar el yate y solo
            deben considerarse dentro de una inspección profesional autorizada.
          </p>
        </section>

        <section aria-labelledby="soft-deck-area">
          <h2 id="soft-deck-area">
            4. ¿Qué puede significar una zona blanda en la cubierta?
          </h2>
          <p>Una zona blanda o flexible puede indicar:</p>
          <ul class="survey-guide-list-grid">
            {article.softAreaCauses.map((cause) => <li>{cause}</li>)}
          </ul>
          <p>
            Algunas partes de la cubierta son naturalmente más flexibles que
            otras. Una evaluación significativa exige compararlas con la
            construcción circundante y comprender el diseño del yate.
          </p>
          <aside class="survey-guide-key-point">
            <strong>
              Una zona blanda es un indicio, no un diagnóstico completo.
            </strong>
          </aside>
        </section>

        <section aria-labelledby="surveyor-investigation">
          <h2 id="surveyor-investigation">
            5. Cómo investiga un inspector naval una posible humedad
          </h2>
          <p>
            El inspector combina distintos métodos y compara los resultados con
            la construcción del yate, las zonas circundantes y el historial
            disponible. Ningún método se trata como un diagnóstico completo por
            sí solo.
          </p>
          <div class="survey-guide-methods">
            {
              article.inspectionMethods.map((method) => (
                <section aria-labelledby={method.id}>
                  <h3 id={method.id}>{method.title}</h3>
                  <p>{method.summary}</p>
                  {method.items.length > 0 && (
                    <ul>
                      {method.items.map((item) => (
                        <li>{item}</li>
                      ))}
                    </ul>
                  )}
                  {method.limitations.length > 0 && (
                    <div class="survey-guide-limitations">
                      <h4>Limitaciones</h4>
                      <ul>
                        {method.limitations.map((limitation) => (
                          <li>{limitation}</li>
                        ))}
                      </ul>
                    </div>
                  )}
                </section>
              ))
            }
          </div>
        </section>

        <section aria-labelledby="moisture-reading-context">
          <h2 id="moisture-reading-context">
            6. Por qué las lecturas de humedad necesitan contexto
          </h2>
          <p>
            Un comprador no debe tomar una decisión a partir de una lectura
            aislada. La interpretación debe considerar:
          </p>
          <ul class="survey-guide-list-grid">
            {article.moistureReadingContext.map((factor) => <li>{factor}</li>)}
          </ul>
          <aside class="survey-guide-key-point">
            <strong>
              Una lectura de humedad es un indicador de inspección, no un
              dictamen estructural independiente.
            </strong>
          </aside>
        </section>

        <section aria-labelledby="repair-implications">
          <h2 id="repair-implications">
            7. ¿La humedad siempre implica una reparación costosa?
          </h2>
          <p><strong>No necesariamente.</strong></p>
          <p>La respuesta puede ir desde:</p>
          <ul class="survey-guide-list-grid">
            {article.repairOutcomes.map((outcome) => <li>{outcome}</li>)}
          </ul>
          <p>La actuación necesaria depende de:</p>
          <ul class="survey-guide-list-grid">
            {article.repairFactors.map((factor) => <li>{factor}</li>)}
          </ul>
          <p>
            El alcance de una reparación debe establecerse para cada yate
            después de evaluar la construcción afectada. Unos precios genéricos
            no ofrecerían una orientación fiable.
          </p>
        </section>

        <section aria-labelledby="buyer-actions">
          <h2 id="buyer-actions">8. Qué debe hacer el comprador</h2>
          <ol class="survey-guide-action-list">
            {
              article.buyerActions.map((action) => (
                <li>
                  <div>
                    <h3>{action.title}</h3>
                    <p>{action.description}</p>
                  </div>
                </li>
              ))
            }
          </ol>
        </section>

        <section aria-labelledby="questions-after-moisture">
          <h2 id="questions-after-moisture">
            9. Preguntas después de detectar posibles indicios de humedad
          </h2>
          <ul class="survey-guide-question-list">
            {
              article.questionsAfterFinding.map((question) => (
                <li>{question}</li>
              ))
            }
          </ul>
        </section>

        <section aria-labelledby="surveyors-key-point">
          <h2 id="surveyors-key-point">10. Punto clave del inspector naval</h2>
          <aside class="survey-guide-key-point survey-guide-key-point-large">
            <p>
              La humedad de la cubierta debe evaluarse dentro del conjunto de la
              construcción y el estado del yate. La conclusión más útil procede
              de combinar evidencias visuales, pruebas comparativas,
              conocimiento de la construcción, condiciones de acceso e historial
              de la embarcación, no de una única lectura.
            </p>
          </aside>
        </section>

        <section aria-labelledby="professional-survey">
          <h2 id="professional-survey">
            11. Cuándo organizar una inspección profesional
          </h2>
          <p>
            Una <a href="/es/pre-purchase-survey"
              >inspección precompra profesional</a
            > resulta especialmente valiosa cuando:
          </p>
          <ul class="survey-guide-list-grid">
            {
              article.professionalSurveyIndicators.map((indicator) => (
                <li>{indicator}</li>
              ))
            }
          </ul>
        </section>
      </div>
    </div>

    <section
      class="survey-guide-related-services"
      aria-labelledby="article-related-services-heading"
    >
      <div class="site-container">
        <div class="survey-guide-section-heading">
          <p class="eyebrow">Asistencia profesional</p>
          <h2 id="article-related-services-heading">Servicio relacionado</h2>
        </div>
        <div class="survey-guide-service-grid">
          {
            article.relatedServices.map((service) => (
              <article>
                <h3>{service.title}</h3>
                <p>{service.description}</p>
                <a class="text-arrow-link" href={service.href}>
                  Ver servicio <span aria-hidden="true">→</span>
                </a>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section
      class="survey-guide-more-tips"
      aria-labelledby="more-survey-tips-heading"
    >
      <div class="site-container survey-guide-more-tips-inner">
        <div>
          <p class="eyebrow">{article.category}</p>
          <h2 id="more-survey-tips-heading">
            Más consejos para la inspección de yates
          </h2>
          <p>
            Continúe con una guía relacionada o consulte todo el centro de
            conocimiento.
          </p>
        </div>
        <ul class="survey-guide-related-link-list" role="list">
          {
            article.relatedArticles.map((relatedArticle) => (
              <li>
                <a class="button button-navy" href={relatedArticle.href}>
                  {relatedArticle.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section
      class="survey-guide-final-cta"
      aria-labelledby="deck-moisture-cta-heading"
    >
      <div class="site-container survey-guide-final-cta-inner">
        <div>
          <p class="eyebrow eyebrow-light">Asistencia precompra</p>
          <h2 id="deck-moisture-cta-heading">{article.finalCta.heading}</h2>
          <p>{article.finalCta.body}</p>
        </div>
        <div class="survey-guide-final-cta-actions">
          {
            article.finalCta.links.map((link, index) => (
              <a
                class:list={[
                  'button',
                  index === 0 ? 'button-light' : 'button-outline-light',
                ]}
                href={link.href}
                {...('external' in link && link.external
                  ? { target: '_blank', rel: 'noreferrer' }
                  : {})}
              >
                {link.label}
                {'external' in link && link.external && (
                  <span class="sr-only">, se abre en una pestaña nueva</span>
                )}
              </a>
            ))
          }
        </div>
      </div>
    </section>
  </article>
</BaseLayout>
