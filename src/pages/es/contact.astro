---
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ContactForm from '../../components/ContactForm.astro';
import SocialLinks from '../../components/SocialLinks.astro';
import { contactPage } from '../../data/contact';
import { siteConfig } from '../../data/site';
import { spanishFooter } from '../../i18n/footer';
import { spanishContactPage } from '../../i18n/contact';
import { getSharedUi } from '../../i18n/ui';
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  businessEntityId,
  toAbsoluteUrl,
  type StructuredData,
} from '../../utils/seo';

const pageUrl = toAbsoluteUrl(spanishContactPage.pathname);
const ui = getSharedUi('es');
const contactPageSchema: StructuredData = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  '@id': `${pageUrl}#page`,
  url: pageUrl,
  name: spanishContactPage.heading,
  description: spanishContactPage.description,
  inLanguage: 'es',
  mainEntity: {
    '@id': businessEntityId,
  },
};
---

<BaseLayout
  title={spanishContactPage.title}
  description={spanishContactPage.description}
  locale="es"
  routeId="contact"
  pathname={spanishContactPage.pathname}
  imagePath={contactPage.heroImage.src}
  imageAlt={contactPage.heroImage.alt}
  structuredData={contactPageSchema}
>
  <header class="service-hero contact-page-hero">
    <img
      class="service-hero-image"
      src={contactPage.heroImage.src}
      alt="Velero en el Mediterráneo, dentro de la zona de servicio de All Yacht Service"
      width={contactPage.heroImage.width}
      height={contactPage.heroImage.height}
      loading="eager"
      fetchpriority="high"
    />
    <div class="service-hero-overlay" aria-hidden="true"></div>
    <div class="service-hero-content site-container">
      <Breadcrumbs
        items={spanishContactPage.breadcrumbs}
        ariaLabel="Migas de pan"
        theme="light"
      />
      <div class="service-hero-copy">
        <p class="eyebrow eyebrow-light">{spanishContactPage.eyebrow}</p>
        <h1>{spanishContactPage.heading}</h1>
        <p>{spanishContactPage.summary}</p>
      </div>
    </div>
  </header>

  <div class="contact-page-main site-container">
    <div class="contact-page-grid">
      <ContactForm locale="es" />

      <aside
        class="contact-sidebar"
        aria-label={spanishContactPage.sidebar.ariaLabel}
      >
        <section aria-labelledby="direct-contact-heading">
          <p class="eyebrow">
            {spanishContactPage.sidebar.directEyebrow}
          </p>
          <h2 id="direct-contact-heading">
            {spanishContactPage.sidebar.directHeading}
          </h2>
          <dl class="contact-sidebar-list">
            <div>
              <dt>{spanishContactPage.sidebar.phone}</dt>
              <dd>
                <a href={siteConfig.contact.phoneHref}
                  >{siteConfig.contact.phone}</a
                >
              </dd>
            </div>
            <div>
              <dt>{spanishContactPage.sidebar.whatsapp}</dt>
              <dd>
                <a
                  href={siteConfig.contact.whatsappHref}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {siteConfig.contact.whatsapp}
                  <span class="sr-only">, {ui.opensNewTab}</span>
                </a>
              </dd>
            </div>
            <div>
              <dt>{spanishContactPage.sidebar.email}</dt>
              <dd>
                <a href={siteConfig.contact.emailHref}
                  >{siteConfig.contact.email}</a
                >
              </dd>
            </div>
          </dl>
          <SocialLinks theme="dark" showLabels={true} locale="es" />
        </section>

        <section aria-labelledby="office-heading">
          <p class="eyebrow">{spanishContactPage.sidebar.officeEyebrow}</p>
          <h2 id="office-heading">
            {spanishContactPage.sidebar.officeHeading}
          </h2>
          <address>
            {spanishFooter.address.map((line) => <span>{line}</span>)}
          </address>
          <p>{spanishContactPage.sidebar.openingHours}</p>
          <p>{spanishContactPage.sidebar.appointments}</p>
          <a
            class="text-arrow-link"
            href={siteConfig.businessProfiles.google}
            target="_blank"
            rel="noopener noreferrer"
          >
            {spanishContactPage.sidebar.google}
            <span aria-hidden="true">→</span>
            <span class="sr-only">, {ui.opensNewTab}</span>
          </a>
        </section>

        <section aria-labelledby="include-heading">
          <p class="eyebrow">{spanishContactPage.sidebar.helpfulEyebrow}</p>
          <h2 id="include-heading">
            {spanishContactPage.sidebar.helpfulHeading}
          </h2>
          <ul class="service-check-list">
            {
              spanishContactPage.sidebar.whatToInclude.map((item) => (
                <li>{item}</li>
              ))
            }
          </ul>
        </section>

        <section aria-labelledby="contact-services-heading">
          <p class="eyebrow">
            {spanishContactPage.sidebar.servicesEyebrow}
          </p>
          <h2 id="contact-services-heading">
            {spanishContactPage.sidebar.servicesHeading}
          </h2>
          <ul class="service-check-list">
            {
              spanishContactPage.sidebar.services.map((service) => (
                <li>
                  <a href={service.href}>{service.label}</a>
                </li>
              ))
            }
          </ul>
        </section>
      </aside>
    </div>

    <section
      id="privacy-notice"
      class="contact-privacy-notice"
      aria-labelledby="privacy-notice-heading"
    >
      <p class="eyebrow">{spanishContactPage.privacy.eyebrow}</p>
      <h2 id="privacy-notice-heading">
        {spanishContactPage.privacy.heading}
      </h2>
      <p>
        {spanishContactPage.privacy.first}
        {' '}<a href={siteConfig.contact.emailHref}
          >{siteConfig.contact.email}</a
        >.
      </p>
      <p>
        {spanishContactPage.privacy.second}
        {' '}<a href="/privacy-policy">Política de privacidad</a>{' '}
        <span class="privacy-language-note">
          Disponible actualmente en inglés.
        </span>
        {' '}{spanishContactPage.privacy.secondAfter}
      </p>
    </section>
  </div>
</BaseLayout>
