---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import ServicesGrid from '../../components/ServicesGrid.astro';
import {
  spanishHomeHero,
  spanishHomeServices,
  spanishKnowledgeResources,
  spanishOnlineTools,
} from '../../data/es/home';
---

<BaseLayout
  title="Servicios profesionales para yates en España | All Yacht Service"
  description="Inspecciones de yates, representación del comprador y entrega profesional en España y el Mediterráneo."
  locale="es"
  routeId="home"
  pathname="/es"
  imagePath="/images/hero-sailing-yacht.webp"
>
  <Hero {...spanishHomeHero} />
  <ServicesGrid
    heading="Servicios para yates"
    eyebrow="Inspección y asistencia técnica"
    services={spanishHomeServices}
    linkLabel="Más información"
  />
  <section class="online-tools-section" aria-labelledby="herramientas-heading">
    <div class="site-container">
      <div class="online-tools-heading">
        <div>
          <p class="eyebrow">Apoyo para la planificación</p>
          <h2 id="herramientas-heading" class="section-heading">
            {spanishOnlineTools.heading}
          </h2>
        </div>
        <p>{spanishOnlineTools.introduction}</p>
      </div>
      <div class="online-tools-grid">
        {
          spanishOnlineTools.items.map((tool) => (
            <article>
              <div>
                <h3>{tool.title}</h3>
                <p>{tool.description}</p>
              </div>
              <a class="button button-outline-navy" href={tool.href}>
                {tool.label}
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </section>
  <ServicesGrid
    heading="Orientación para compradores y propietarios"
    eyebrow="Centro de conocimiento"
    services={spanishKnowledgeResources}
    linkLabel="Leer los consejos"
  />
</BaseLayout>
