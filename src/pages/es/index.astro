---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PendingHomepage from '../../components/PendingHomepage.astro';
import ServicesGrid from '../../components/ServicesGrid.astro';
import { spanishHomeServices } from '../../data/es/home';
---

<BaseLayout
  title="Servicios profesionales para yates en España | All Yacht Service"
  description="Inspecciones de yates, representación del comprador y entrega profesional en España y el Mediterráneo."
  locale="es"
  routeId="home"
  pathname="/es"
  imagePath="/images/hero-sailing-yacht.webp"
>
  <PendingHomepage
    heading="Sitio web de All Yacht Service"
    notice="Contenido pendiente"
    imageAlt="Velero navegando en el mar"
  />
  <ServicesGrid
    heading="Servicios para yates"
    eyebrow="Inspección y asistencia técnica"
    services={spanishHomeServices}
    linkLabel="Más información"
  />
</BaseLayout>
