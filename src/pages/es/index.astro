---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="All Yacht Service | Español"
  description="Página de inicio temporal de All Yacht Service en español. El contenido está pendiente."
  locale="es"
  routeId="home"
  pathname="/es"
>
  <section class="site-container py-20 sm:py-28">
    <h1
      class="max-w-4xl font-display text-4xl leading-tight font-bold text-navy sm:text-6xl"
    >
      Sitio web de All Yacht Service
    </h1>
    <p class="development-notice mt-10 max-w-2xl" role="status">
      Contenido pendiente
    </p>
  </section>
</BaseLayout>
