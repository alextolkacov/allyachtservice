---
import PrePurchaseSurveyCalculator from '../../components/PrePurchaseSurveyCalculator.astro';
import { spanishPrePurchaseSurveyCalculatorPage as page } from '../../data/es/pre-purchase-survey-calculator';
import ServiceLayout from '../../layouts/ServiceLayout.astro';
import {
  businessEntityId,
  toAbsoluteUrl,
  type StructuredData,
} from '../../utils/seo';

const pageUrl = toAbsoluteUrl(page.pathname);
const webPageSchema: StructuredData = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': `${pageUrl}#page`,
  url: pageUrl,
  name: page.title,
  description: page.description,
  inLanguage: 'es',
  about: {
    '@id': businessEntityId,
  },
};
---

<ServiceLayout
  title={page.title}
  description={page.description}
  locale="es"
  routeId="prePurchaseSurveyCalculator"
  pathname={page.pathname}
  heading={page.heading}
  eyebrow={page.eyebrow}
  summary={page.summary}
  heroImage={page.heroImage}
  socialImageAlt={page.socialImageAlt}
  breadcrumbs={page.breadcrumbs}
  breadcrumbLabel="Migas de pan"
  primaryCta={page.primaryCta}
  secondaryCta={page.secondaryCta}
  relatedServices={page.relatedServices}
  finalCta={page.finalCta}
  structuredData={webPageSchema}
>
  <section aria-labelledby="estimacion-inicial-heading">
    <h2 id="estimacion-inicial-heading">
      Calcule una estimación inicial de la inspección
    </h2>
    <p>
      Utilice la calculadora para obtener una indicación inicial de los
      honorarios profesionales de una inspección precompra. Seleccione la
      eslora, el tipo de yate y el alcance que mejor se ajusten a sus
      necesidades.
    </p>
    <p>
      El resultado sirve para la planificación inicial y no constituye un
      presupuesto vinculante. El alcance y el precio formal se confirmarán
      después de revisar los datos, la ubicación, el acceso y el estado del
      yate.
    </p>
  </section>

  <PrePurchaseSurveyCalculator locale="es" />

  <section aria-labelledby="incluido-heading">
    <h2 id="incluido-heading">¿Qué puede incluir?</h2>
    <ul class="service-check-list">
      {page.includedItems.map((item) => <li>{item}</li>)}
    </ul>
    <p>
      Consulte más información sobre el proceso de inspección y el informe en la
      {' '}<a class="text-link" href="/es/pre-purchase-survey"
        >página del servicio de inspección precompra</a
      >.
    </p>
  </section>

  <section aria-labelledby="diferencias-presupuesto-heading">
    <h2 id="diferencias-presupuesto-heading">
      ¿Por qué puede variar el presupuesto final?
    </h2>
    <p>
      La calculadora aplica las reglas aprobadas según la eslora y el alcance,
      pero no puede valorar por completo todos los factores que pueden influir
      en el trabajo final:
    </p>
    <ul class="defect-grid">
      {page.quotationFactors.map((factor) => <li>{factor}</li>)}
    </ul>
  </section>

  <section aria-labelledby="siguientes-pasos-heading">
    <h2 id="siguientes-pasos-heading">¿Qué ocurre después?</h2>
    <ol class="process-list">
      {
        page.nextSteps.map((step, index) => (
          <li>
            <div>
              <span aria-hidden="true">
                {String(index + 1).padStart(2, '0')}
              </span>
            </div>
            <div>
              <h3>{step.title}</h3>
              <p>{step.description}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <aside
    class="related-online-tool"
    aria-labelledby="herramienta-relacionada-heading"
  >
    <h2 id="herramienta-relacionada-heading">Herramienta relacionada</h2>
    <p>
      ¿Está planificando el traslado de un yate?
      {' '}<a class="text-link" href="/es/yacht-delivery-calculator"
        >Utilice la calculadora de entrega de yates</a
      >.
    </p>
  </aside>
</ServiceLayout>
