---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="All Yacht Service | Français"
  description="Page d’accueil temporaire d’All Yacht Service en français. Contenu en attente."
  locale="fr"
  routeId="home"
  pathname="/fr"
>
  <section class="site-container py-20 sm:py-28">
    <h1
      class="max-w-4xl font-display text-4xl leading-tight font-bold text-navy sm:text-6xl"
    >
      Site web d’All Yacht Service
    </h1>
    <p class="development-notice mt-10 max-w-2xl" role="status">
      Contenu en attente
    </p>
  </section>
</BaseLayout>
